@model LearningManagementSystem.Models.ViewModels.UserProfileEditViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cập nhật ảnh đại diện";
}

@section Styles {
    <link href="~/css/Account/UserProfileEdit.css" rel="stylesheet" asp-append-version="true" />
    <style>
        /* Style riêng cho trang UpdateAvatar */
        .current-avatar-preview {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 4px solid var(--border);
            background-color: var(--bg-light);
            margin-bottom: 1rem;
            overflow: hidden;
        }

            .current-avatar-preview img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .current-avatar-preview .no-avatar {
                font-size: 3rem;
                color: var(--gray-500);
                font-weight: 600;
            }
    </style>
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/Account/UpdateAvatar.js" defer asp-append-version="true"></script>

<form id="hiddenForm" style="display: none;">
    <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
</form>

<div class="container mt-4 mb-5">
    <div class="row g-4">

        <div class="col-lg-3">
            <div class="profile-nav-wrapper sticky-top" style="top: 90px;">
                <div class="profile-nav card shadow-sm border-0">
                    <div class="card-body p-3">
                        <nav class="nav nav-pills flex-column">
                            <a class="nav-link" href="@Url.Action("EditProfile", "Account")">
                                <i class="bi bi-person-fill me-2"></i> Hồ sơ công khai
                            </a>
                            <a class="nav-link active" href="@Url.Action("UpdateAvatar", "Account")">
                                <i class="bi bi-camera-fill me-2"></i> Ảnh đại diện
                            </a>
                            <a class="nav-link" href="@Url.Action("ChangePassword", "Account")">
                                <i class="bi bi-key-fill me-2"></i> Đổi mật khẩu
                            </a>

                            <hr class="my-2" />

                            <form id="deleteAccountForm" asp-action="DeleteAccount" asp-controller="Account" method="post" class="d-none">
                                <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
                            </form>
                            <button type="button" class="nav-link text-danger btn-delete-account" onclick="confirmDelete()">
                                <i class="bi bi-trash-fill me-2"></i> Đóng tài khoản
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="content-card card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>@TempData["Success"]</div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }

                    <div class="section">
                        <div class="section-header pb-3 mb-4 border-bottom">
                            <h3 class="mb-0">Cập nhật ảnh đại diện</h3>
                            <p class="text-muted mb-0">Thay đổi ảnh đại diện của bạn.</p>
                        </div>

                        <form asp-action="UpdateAvatar" asp-controller="Account" method="post" enctype="multipart/form-data" class="profile-form">
                            <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />

                            <div class="mb-3">
                                <label class="form-label fw-bold">Ảnh đại diện hiện tại</label>
                                <div class="current-avatar-preview">
                                    @if (!string.IsNullOrEmpty(ViewBag.Avatar) && ViewBag.IsAvatarExists)
                                    {
                                        <img src="@ViewBag.Avatar" alt="Avatar">
                                    }
                                    else
                                    {
                                        <div class="no-avatar">
                                            @Model.UserName.First()
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="avatarFile" class="form-label fw-bold">Tải lên ảnh mới</label>
                                <input type="file" name="avatarFile" id="avatarFile" class="form-control" accept="image/*" required />
                                <small class="form-text text-muted">Chấp nhận file .jpg, .png, .jpeg. Tối đa 5MB.</small>

                                @if (ViewData.ModelState.ContainsKey("avatarFile"))
                                {
                                    <div class="text-danger small mt-1">
                                        @ViewData.ModelState["avatarFile"].Errors.FirstOrDefault()?.ErrorMessage
                                    </div>
                                }
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg mt-3">
                                <i class="bi bi-upload me-1"></i> Cập nhật ảnh
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>