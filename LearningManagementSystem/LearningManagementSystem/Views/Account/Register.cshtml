
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký - E-Learning System";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/AuthBase.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/Register.css")" rel="stylesheet" />
</head>
<body class="auth-layout">
    <div class="auth-wrapper container-fluid">
        <div class="row align-items-center min-vh-100 justify-content-center g-5 auth-row">
            <div class="col-lg-6 col-xl-6 d-none d-lg-block">
                <div class="auth-illustration">
                    <img src="~/images/illustrations/auth-learning.svg" alt="Learning illustration" class="img-fluid" />
                    <div class="illustration-caption">
                        <h2>Xây dựng tương lai của bạn</h2>
                        <p>Đăng ký để khám phá thư viện khóa học phong phú và nhận lộ trình học cá nhân.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-7 col-sm-10 offset-lg-1">
                <div class="auth-panel shadow-sm">
                    <div class="brand-badge mb-3">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h1 class="auth-heading">Tạo tài khoản E-Learning</h1>
                    <p class="auth-subheading">Điền thông tin để bắt đầu học ngay hôm nay.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-check-circle"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@TempData["Error"]</span>
                        </div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 small" role="alert">
                            <i class="bi bi-exclamation-circle mt-1"></i>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <p class="mb-0">@error.ErrorMessage</p>
                                }
                            </div>
                        </div>
                    }

                    <form asp-action="Register" asp-controller="Account" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="FullName" class="form-label">Họ và tên</label>
                            <input type="text" name="FullName" id="FullName" class="form-control auth-input" placeholder="Nhập họ và tên" required />
                        </div>
                        <div class="mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" name="Email" id="Email" class="form-control auth-input" placeholder="Nhập email" required />
                        </div>
                        <div class="mb-3">
                            <label for="UserName" class="form-label">Tên đăng nhập</label>
                            <input type="text" name="UserName" id="UserName" class="form-control auth-input" placeholder="Nhập tên đăng nhập" required />
                        </div>
                        <div class="mb-3 position-relative">
                            <label for="password" class="form-label">Mật khẩu</label>
                            <input type="password" name="password" id="password" class="form-control auth-input" placeholder="Nhập mật khẩu" required />
                            <button type="button" class="toggle-password" data-target="password" aria-label="Hiển thị mật khẩu">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="mb-4 position-relative">
                            <label for="confirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control auth-input" placeholder="Nhập lại mật khẩu" required />
                            <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Hiển thị mật khẩu">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            Đăng ký
                        </button>

                        <div class="divider">
                            <span>hoặc đăng ký bằng</span>
                        </div>

                        <div class="social-login justify-content-center">
                            <a href="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = Context.Request.Query["returnUrl"] })" class="social-btn">
                                <i class="bi bi-google"></i>
                                Google
                            </a>
                        </div>

                        <div class="auth-footer flex-column">
                            <div>
                                <span>Đã có tài khoản?</span>
                                <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                            </div>
                            <small class="text-muted mt-2">
                                Bằng việc đăng ký, bạn đồng ý với <a href="#">Điều khoản sử dụng</a> và <a href="#">Chính sách bảo mật</a>.
                            </small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/js/Account/Register.js")"></script>
</body>
</html>
