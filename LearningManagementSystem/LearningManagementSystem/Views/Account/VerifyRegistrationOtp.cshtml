
@{
    Layout = null;
    ViewData["Title"] = "Xác minh email đăng ký - E-Learning System";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/AuthBase.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/VerifyOtp.css")" rel="stylesheet" />
</head>
<body class="auth-layout">
    <div class="auth-wrapper container-fluid">
        <div class="row align-items-center min-vh-100 justify-content-center g-5 auth-row">
            <div class="col-lg-6 col-xl-6 d-none d-lg-block">
                <div class="auth-illustration">
                    <img src="~/images/illustrations/auth-otp.svg" alt="OTP verification illustration" class="img-fluid" />
                    <div class="illustration-caption">
                        <h2>Xác nhận email của bạn</h2>
                        <p>Mã OTP giúp đảm bảo email của bạn là hợp lệ và bạn là chủ sở hữu của email này.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-7 col-sm-10 offset-lg-1">
                <div class="auth-panel shadow-sm">
                    <div class="brand-badge mb-3">
                        <i class="bi bi-envelope-check"></i>
                    </div>
                    <h1 class="auth-heading">Xác minh email đăng ký</h1>
                    <p class="auth-subheading">Nhập mã OTP đã được gửi đến email <strong>@ViewBag.Email</strong></p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-check-circle"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@TempData["Error"]</span>
                        </div>
                    }

                    <form asp-action="VerifyRegistrationOtp" asp-controller="Account" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@ViewBag.Email" />
                        <div class="mb-3">
                            <label for="otp" class="form-label">Mã OTP</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-123"></i></span>
                                <input type="text"
                                       name="otp"
                                       id="otp"
                                       class="form-control auth-input"
                                       placeholder="Nhập mã OTP 6 chữ số"
                                       maxlength="6"
                                       pattern="[0-9]{6}"
                                       required />
                            </div>
                            <small class="form-text text-muted">Mã OTP gồm 6 chữ số</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-shield-check me-1"></i>Xác minh
                        </button>

                        <div class="auth-footer d-flex justify-content-between align-items-center">
                            <form asp-action="ResendRegistrationOtp" asp-controller="Account" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="email" value="@ViewBag.Email" />
                                <input type="hidden" name="userName" value="@ViewBag.UserName" />
                                <button type="submit" class="btn btn-link text-link p-0">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Gửi lại mã OTP
                                </button>
                            </form>
                            <a href="@Url.Action("Register", "Account")" class="text-link">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại đăng ký
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>

