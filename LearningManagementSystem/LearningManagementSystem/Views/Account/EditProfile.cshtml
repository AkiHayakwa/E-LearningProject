@model LearningManagementSystem.Models.ViewModels.UserProfileEditViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chỉnh sửa hồ sơ - E-Learning System";
}

<div class="container my-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="card shadow-sm p-3 mb-4" style="border-radius: 10px;">
                <div class="text-center">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mx-auto" style="width: 80px; height: 80px; font-size: 2rem;">
                        @Model.UserName.First()
                    </div>
                    <h5 class="mt-3">@Model.UserName</h5>
                    <a href="@Url.Action("EditProfile", "Account")" class="text-purple">Xem hồ sơ công khai</a>
                </div>
                <hr />
                <ul class="list-group list-group-flush">
                    <li class="list-group-item active" style="background-color: #f8f9fa; border: none;">
                        <a href="@Url.Action("EditProfile", "Account")" class="text-dark">Hồ sơ</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Ảnh</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Bảo mật tài khoản</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Đăng ký</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Phương thức thanh toán</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Quyền riêng tư</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Tùy chọn thông báo</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">API clients</a>
                    </li>
                    <li class="list-group-item" style="background-color: #f8f9fa; border: none;">
                        <a href="#" class="text-dark">Đóng tài khoản</a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Form chỉnh sửa hồ sơ -->
        <div class="col-md-9">
            <div class="card shadow-sm p-4" style="border-radius: 10px;">
                <h3 class="mb-4">Hồ sơ công khai</h3>
                <p class="text-muted mb-4">Chỉnh sửa thông tin cá nhân của bạn</p>

                <!-- Hiển thị thông báo -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="EditProfile" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <h5 class="mb-3">Cơ bản:</h5>
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Tên đăng nhập</label>
                        <input asp-for="UserName" class="form-control" readonly style="background-color: #f8f9fa;" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-purple mt-3">Lưu thay đổi</button>
                </form>

                <!-- Danh sách khóa học đã đăng ký -->
                <h5 class="mb-3 mt-4">Khóa học đã đăng ký:</h5>
                @if (Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
                {
                    <ul class="list-group">
                        @foreach (var course in Model.EnrolledCourses)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @course.Title
                                <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn btn-sm btn-purple">Xem chi tiết</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Bạn chưa đăng ký khóa học nào.</p>
                }

                <!-- Danh sách bình luận -->
                <h5 class="mb-3 mt-4">Bình luận của bạn:</h5>
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    <ul class="list-group">
                        @foreach (var comment in Model.Comments)
                        {
                            <li class="list-group-item">
                                <p><strong>Khóa học:</strong> @comment.CourseTitle</p>
                                <p>@comment.Content</p>
                                <small class="text-muted">Đăng vào: @comment.CommentDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Bạn chưa có bình luận nào.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-purple {
            background-color: #a435f0;
            color: white;
        }

            .btn-purple:hover {
                background-color: #8a2be2;
                box-shadow: 0 4px 12px rgba(164, 53, 240, 0.4);
                transform: translateY(-2px);
            }

        .text-purple {
            color: #a435f0 !important;
        }

            .text-purple:hover {
                color: #8a2be2 !important;
            }

        .list-group-item.active {
            background-color: #e9ecef !important;
            border-color: #e9ecef !important;
        }
    </style>
}

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}