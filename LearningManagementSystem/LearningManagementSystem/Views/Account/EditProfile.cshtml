@model LearningManagementSystem.Models.ViewModels.UserProfileEditViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<link href="~/css/Account/UserProfileEdit.css" rel="stylesheet" asp-append-version="true" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/Account/UserProfileEdit.js" defer asp-append-version="true"></script>

<form id="hiddenForm" style="display: none;">
    <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
</form>

<div class="container mt-4 mb-5">
    <div class="row g-4">

        <div class="col-lg-3">
            <div class="profile-nav-wrapper sticky-top" style="top: 90px;">
                <div class="profile-nav card shadow-sm border-0">
                    <div class="card-body p-3">
                        <nav class="nav nav-pills flex-column">
                            <a class="nav-link active" href="@Url.Action("EditProfile", "Account")">
                                <i class="bi bi-person-fill me-2"></i> Hồ sơ công khai
                            </a>
                            <a class="nav-link" href="@Url.Action("UpdateAvatar", "Account")">
                                <i class="bi bi-camera-fill me-2"></i> Ảnh đại diện
                            </a>
                            <a class="nav-link" href="@Url.Action("ChangePassword", "Account")">
                                <i class="bi bi-key-fill me-2"></i> Đổi mật khẩu
                            </a>

                            <hr class="my-2" />

                            <form id="deleteAccountForm" asp-action="DeleteAccount" asp-controller="Account" method="post" class="d-none">
                                <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
                            </form>

                            <button type="button" class="nav-link text-danger btn-delete-account" onclick="confirmDelete()">
                                <i class="bi bi-trash-fill me-2"></i> Đóng tài khoản
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="content-card card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>@TempData["Success"]</div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }

                    <div class="section">
                        <div class="section-header pb-3 mb-4 border-bottom">
                            <h3 class="mb-0">Hồ sơ công khai</h3>
                            <p class="text-muted mb-0">Chỉnh sửa thông tin cá nhân của bạn.</p>
                        </div>

                        <form asp-action="EditProfile" asp-controller="Account" method="post" class="profile-form">
                            <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label fw-bold">Tên đăng nhập</label>
                                <input asp-for="UserName" class="form-control" readonly />
                                <small class="form-text text-muted">Tên đăng nhập không thể thay đổi.</small>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName" class="form-label fw-bold">Họ và tên</label>
                                    <input asp-for="FullName" class="form-control" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                                    <input asp-for="Email" class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Bio" class="form-label fw-bold">Tiểu sử</label>
                                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Giới thiệu ngắn về bản thân bạn..."></textarea>
                                <small class="form-text text-muted">Thông tin này sẽ hiển thị công khai trên hồ sơ của bạn.</small>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg mt-3">
                                <i class="bi bi-save me-1"></i> Lưu thay đổi
                            </button>
                        </form>
                    </div>

                    <hr class="my-5" />

                    <div class="section">
                        <div class="section-header pb-3 mb-4 border-bottom">
                            <h3 class="mb-0">Bình luận của bạn</h3>
                        </div>

                        @if (Model.Comments != null && Model.Comments.Any())
                        {
                            <div class="comments-list">
                                @foreach (var comment in Model.Comments.OrderByDescending(c => c.CommentDate).Take(5))
                                {
                                    <div class="comment-item">
                                        <div class="comment-header">
                                            <div class="d-flex flex-column">
                                                <a href="@Url.Action("Details", "Course", new { id = comment.CourseId})" class="comment-course-title">
                                                    @comment.CourseTitle
                                                </a>
                                                @if (comment.Rating.HasValue && comment.Rating > 0)
                                                {
                                                    <div class="comment-rating mt-1">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="bi bi-star-fill @(i <= comment.Rating.Value ? "text-warning" : "text-muted")" style="font-size: 0.9rem;"></i>
                                                        }
                                                        <span class="ms-2 text-muted small">@comment.Rating.Value/5</span>
                                                    </div>
                                                }
                                            </div>
                                            <span class="comment-date ms-auto">
                                                @comment.CommentDate.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </div>
                                        <div class="comment-content">
                                            @comment.Content
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="info-message text-center p-4 bg-light rounded">
                                <i class="fas fa-comment-dots fa-2x text-muted mb-2"></i>
                                <p class="mb-0 text-muted">Bạn chưa có bình luận nào.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>