@model LearningManagementSystem.Models.ViewModels.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <link href="~/css/Account/UserProfileEdit.css" rel="stylesheet" asp-append-version="true" />
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/Account/ChangePassword.js" defer asp-append-version="true"></script>

<form id="hiddenForm" style="display: none;">
    <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
</form>

<div class="container mt-4 mb-5">
    <div class="row g-4">

        <div class="col-lg-3">
            <div class="profile-nav-wrapper sticky-top" style="top: 90px;">
                <div class="profile-nav card shadow-sm border-0">
                    <div class="card-body p-3">
                        <nav class="nav nav-pills flex-column">
                            <a class="nav-link" href="@Url.Action("EditProfile", "Account")">
                                <i class="bi bi-person-fill me-2"></i> Hồ sơ công khai
                            </a>
                            <a class="nav-link" href="@Url.Action("UpdateAvatar", "Account")">
                                <i class="bi bi-camera-fill me-2"></i> Ảnh đại diện
                            </a>
                            <a class="nav-link active" href="@Url.Action("ChangePassword", "Account")">
                                <i class="bi bi-key-fill me-2"></i> Đổi mật khẩu
                            </a>

                            <hr class="my-2" />

                            <form id="deleteAccountForm" asp-action="DeleteAccount" asp-controller="Account" method="post" class="d-none">
                                <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
                            </form>
                            <button type="button" class="nav-link text-danger btn-delete-account" onclick="confirmDelete()">
                                <i class="bi bi-trash-fill me-2"></i> Đóng tài khoản
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="content-card card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>@TempData["Success"]</div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i> Đã xảy ra lỗi</h5>
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }

                    <div class="section">
                        <div class="section-header pb-3 mb-4 border-bottom">
                            <h3 class="mb-0">Đổi mật khẩu</h3>
                            <p class="text-muted mb-0">Để bảo mật, hãy sử dụng mật khẩu mạnh.</p>
                        </div>

                        <form asp-action="ChangePassword" asp-controller="Account" method="post" class="profile-form">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="CurrentPassword" class="form-label fw-bold"></label>
                                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewPassword" class="form-label fw-bold"></label>
                                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" />
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg mt-3">
                                <i class="bi bi-key me-1"></i> Thay đổi mật khẩu
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}