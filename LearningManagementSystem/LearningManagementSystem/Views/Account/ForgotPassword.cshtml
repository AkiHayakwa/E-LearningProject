@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu - E-Learning System";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/AuthBase.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/ForgotPassword.css")" rel="stylesheet" />
</head>
<body class="auth-layout">
    <div class="auth-wrapper container-fluid">
        <div class="row align-items-center min-vh-100 justify-content-center g-5 auth-row">
            <div class="col-lg-6 col-xl-6 d-none d-lg-block">
                <div class="auth-illustration">
                    <img src="~/images/illustrations/auth-forgot.svg" alt="Forgot password illustration" class="img-fluid" />
                    <div class="illustration-caption">
                        <h2>Quên mật khẩu?</h2>
                        <p>Đừng lo, chúng tôi sẽ gửi mã OTP để giúp bạn đặt lại mật khẩu thật nhanh chóng.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-7 col-sm-10 offset-lg-1">
                <div class="auth-panel shadow-sm">
                    <div class="brand-badge mb-3">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h1 class="auth-heading">Quên mật khẩu?</h1>
                    <p class="auth-subheading">Nhập email của bạn để nhận mã OTP xác nhận.</p>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@ViewBag.Message</span>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-check-circle"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email"
                                       name="email"
                                       id="email"
                                       class="form-control auth-input"
                                       placeholder="Nhập email của bạn"
                                       required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-send me-1"></i>Gửi mã OTP
                        </button>

                        <div class="auth-footer justify-content-center">
                            <a href="@Url.Action("Login", "Account")" class="text-link">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/js/Account/ForgotPassword.js")"></script>
</body>
</html>
