@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - E-Learning System";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/AuthBase.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Account/Login.css")" rel="stylesheet" />
</head>
<body class="auth-layout">
    <div class="auth-wrapper container-fluid">
        <div class="row align-items-center min-vh-100 justify-content-center g-5 auth-row">
            <div class="col-lg-6 col-xl-6 d-none d-lg-block">
                <div class="auth-illustration">
                    <img src="~/images/illustrations/auth-learning.svg" alt="Learning illustration" class="img-fluid" />
                    <div class="illustration-caption">
                        <h2>Đăng nhập để tiếp tục hành trình học tập</h2>
                        <p>Khám phá hàng trăm khóa học chất lượng cao cùng lộ trình dành riêng cho bạn.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-7 col-sm-10 offset-lg-1">
                <div class="auth-panel shadow-sm">
                    <div class="brand-badge mb-3">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <h1 class="auth-heading">Đăng nhập để tiếp tục hành trình học tập của bạn</h1>
                    <p class="auth-subheading">Nhập thông tin tài khoản để tiếp tục.</p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@TempData["Error"]</span>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 small" role="alert">
                            <i class="bi bi-check-circle"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" class="auth-form">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="loginUserName" class="form-label">Tên đăng nhập</label>
                            <input type="text" name="UserName" id="loginUserName" class="form-control auth-input" placeholder="Nhập tên đăng nhập" required />
                        </div>

                        <div class="mb-2 position-relative">
                            <label for="loginPassword" class="form-label">Mật khẩu</label>
                            <input type="password" name="Password" id="loginPassword" class="form-control auth-input" placeholder="Nhập mật khẩu" required />
                            <button type="button" class="toggle-password" data-target="loginPassword" aria-label="Hiển thị mật khẩu">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="rememberMe" name="RememberMe" />
                                <label class="form-check-label" for="rememberMe">Ghi nhớ tôi</label>
                            </div>
                            <a href="@Url.Action("ForgotPassword", "Account")" class="text-link">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            Tiếp tục
                        </button>

                        <div class="divider">
                            <span>hoặc đăng nhập bằng</span>
                        </div>

                        <div class="social-login justify-content-center">
                            <a href="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = Context.Request.Query["returnUrl"] })" class="social-btn">
                                <i class="bi bi-google"></i>
                                Google
                            </a>
                        </div>

                        <div class="auth-footer">
                            <span>Bạn chưa có tài khoản?</span>
                            <a href="@Url.Action("Register", "Account")">Đăng ký miễn phí</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/js/Account/Login.js")"></script>
</body>
</html>
