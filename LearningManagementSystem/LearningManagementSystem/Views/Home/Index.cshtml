@model LearningManagementSystem.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - E-Learning System";
    Layout = "_Layout";
}

<form id="hiddenForm" style="display: none;">
    <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
</form>

<div class="container-fluid p-0">
    <div class="hero-section text-white text-center p-5 mb-5">
        <div class="container">
            <div class="user-welcome-container hero-banner">
                <div class="hero-banner-content text-start">
                    <div class="d-flex align-items-center mb-3 gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="avatar-container">
                                <img src="@(string.IsNullOrEmpty(Model.User?.Avatar) ? "/images/default-avatar.jpg" : Model.User.Avatar)" alt="User Avatar" class="user-avatar shadow" />
                            </div>
                        }
                        <div>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <h1 class="hero-title fw-bold mb-1"><span data-i18n="welcome_back">Chào mừng trở lại</span>, @User.Identity.Name!</h1>
                                <p class="hero-subtitle mb-0" data-i18n="continue_journey">Hãy tiếp tục hành trình chinh phục tri thức của bạn ngay hôm nay.</p>
                            }
                            else
                            {
                                <h1 class="hero-title fw-bold mb-1" data-i18n="welcome_to_system">Chào mừng đến với E-Learning System!</h1>
                                <p class="hero-subtitle mb-0" data-i18n="explore_courses_desc">Khám phá các khóa học Công nghệ Thông tin và nâng cao kỹ năng của bạn.</p>
                            }
                        </div>
                    </div>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-hero-primary btn-lg mt-2">
                        <span class="btn-content">
                            <i class="fas fa-graduation-cap me-2"></i>
                            <span data-i18n="start_learning_now">Bắt đầu học ngay</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">

        @if (TempData["Success"] != null)
        {
            <div class="notification success">
                @TempData["Success"]
                <button type="button" class="close-btn" onclick="this.parentElement.style.display='none'">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="notification error">
                @TempData["Error"]
                <button type="button" class="close-btn" onclick="this.parentElement.style.display='none'">&times;</button>
            </div>
        }

        <div class="row mb-4">
            <div class="col-12">
                <div class="promo-banner-container rounded-3 overflow-hidden shadow-sm">
                    <div class="slider">
                        <div class="slides">
                            <div class="slide active">
                                <img src="/images/banner11.png" alt="Đường đua lập trình" class="img-fluid banner-image" />
                            </div>
                            <div class="slide">
                                <img src="/images/banner12.jpg" alt="Đường đua lập trình 2" class="img-fluid banner-image" />
                            </div>
                            <div class="slide">
                                <img src="/images/banner13.png" alt="Đường đua lập trình 3" class="img-fluid banner-image" />
                            </div>
                        </div>
                        <button class="slider-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
                        <button class="slider-btn next-btn"><i class="fas fa-chevron-right"></i></button>
                        <div class="slider-dots">
                            <span class="dot active" data-index="0"></span>
                            <span class="dot" data-index="1"></span>
                            <span class="dot" data-index="2"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="course-tabs mb-4">
            <ul class="nav nav-tabs nav-tabs-modern" id="courseTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="suggested-tab" data-bs-toggle="tab" data-bs-target="#suggested-tabs" type="button" role="tab" aria-controls="suggested-tabs" aria-selected="true">
                        <i class="fas fa-lightbulb me-1"></i> <span data-i18n-vi="Khóa học gợi ý" data-i18n-en="Suggested courses">Khóa học gợi ý</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="enrolled-tab" data-bs-toggle="tab" data-bs-target="#enrolled" type="button" role="tab" aria-controls="enrolled" aria-selected="false">
                        <i class="fas fa-book-reader me-1"></i> <span data-i18n-vi="Đang học" data-i18n-en="Enrolled">Đang học</span> (@Model.Courses.Count(c => c.IsEnrolled))
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="courseTabContent">

            <div class="tab-pane fade show active" id="suggested-tabs" role="tabpanel" aria-labelledby="suggested-tab">
                <div class="row g-4" id="suggestedCourses">
                    @if (!Model.Courses.Any(c => !c.IsEnrolled))
                    {
                        <div class="col-12">
                            <div class="info-message">
                                <i class="fas fa-info-circle"></i> <span data-i18n-vi="Không có khóa học gợi ý nào." data-i18n-en="No suggested courses available.">Không có khóa học gợi ý nào.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var course in Model.Courses.Where(c => !c.IsEnrolled))
                        {
                            <div class="col-md-6 col-lg-3 mb-4 course-item">
                                <div class="course-card h-100 animate__animated animate__fadeInUp" 
                                     data-bs-toggle="popover" 
                                     data-bs-trigger="hover"
                                     data-bs-placement="auto"
                                     data-bs-html="true"
                                     data-course-id="@course.CourseId"
                                     data-course-description="@(course.Description ?? "")"
                                     data-course-instructor="@(course.InstructorName ?? "")"
                                     data-course-lessons="@(course.Lessons?.Count ?? 0)"
                                     data-bs-content="">
                                    <div class="course-image-wrapper">
                                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                                        {
                                            <img src="@course.ImageUrl" class="course-image" alt="@course.CourseName">
                                        }
                                        else
                                        {
                                            <img src="/images/default-course.jpg" class="course-image" alt="Default Image">
                                        }
                                        <div class="course-overlay">
                                            <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn btn-light btn-sm rounded-pill">
                                                <i class="bi bi-eye me-1"></i><span data-i18n-vi="Xem chi tiết" data-i18n-en="View details">Xem chi tiết</span>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="course-rating">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi bi-star-fill text-warning" style="@(i <= Math.Ceiling(course.AverageRating ?? 0) ? "" : "color: #e9ecef;")"></i>
                                                }
                                                <span class="ms-2">@(course.AverageRating.HasValue ? course.AverageRating.Value.ToString("F1") : "Chưa có đánh giá")</span>
                                            </div>
                                        </div>
                                        <h5 class="card-title mb-2">@course.CourseName</h5>
                                        <p class="card-text text-muted description-text">@course.Description</p>
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            @if (!string.IsNullOrWhiteSpace(course.Level))
                                            {
                                                <span class="badge bg-light text-primary border">@course.Level</span>
                                            }
                                            @if (course.DurationMinutes.HasValue)
                                            {
                                                <span class="badge bg-info-subtle text-info"><i class="bi bi-clock me-1"></i>@course.DurationMinutes.Value phút</span>
                                            }
                                            @foreach (var tag in course.TagNames ?? new List<string>())
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">@tag</span>
                                            }
                                        </div>
                                        <div class="text-muted small mb-2">
                                            <i class="bi bi-clock me-1"></i>@(course.DurationMinutes.HasValue ? $"{course.DurationMinutes} phút" : "Thời lượng linh hoạt")
                                        </div>
                                        <div class="mt-auto pt-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="course-lessons">
                                                    <i class="bi bi-collection me-1"></i>
                                                    <span>@(course.Lessons?.Count ?? 0) <span data-i18n-vi="bài học" data-i18n-en="lessons">bài học</span></span>
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="course-price fw-bold text-primary">
                                                    @(course.Price.HasValue ? $"{course.Price.Value:N0}₫" : "Miễn phí")
                                                </div>
                                                <div>
                                                    @if (User.Identity.IsAuthenticated)
                                                    {
                                                        @if (course.Price.HasValue && course.Price > 0)
                                                        {
                                                            @if (Model.CartCourseIds != null && Model.CartCourseIds.Contains(course.CourseId))
                                                            {
                                                                <span class="text-success fw-bold small"><i class="bi bi-cart-check me-1"></i><span data-i18n-vi="Đã trong giỏ" data-i18n-en="In cart">Đã trong giỏ</span></span>
                                                            }
                                                            else
                                                            {
                                                                <form asp-action="AddToCart" asp-controller="Cart" asp-route-courseId="@course.CourseId" method="post" class="d-inline">
                                                                    <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
                                                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill">
                                                                        <i class="bi bi-cart-plus me-1"></i><span data-i18n-vi="Đăng ký" data-i18n-en="Enroll">Đăng ký</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <form asp-action="Enroll" asp-controller="Enrollment" asp-route-courseId="@course.CourseId" method="post" class="d-inline">
                                                                <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
                                                                <button type="submit" class="btn btn-primary btn-sm rounded-pill">
                                                                    <i class="bi bi-cart-plus me-1"></i><span data-i18n-vi="Đăng ký" data-i18n-en="Enroll">Đăng ký</span>
                                                                </button>
                                                            </form>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-sm rounded-pill">
                                                            <i class="bi bi-box-arrow-in-right me-1"></i><span data-i18n-vi="Đăng nhập" data-i18n-en="Log in">Đăng nhập</span>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Courses.Any(c => !c.IsEnrolled))
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div id="suggestedPaginationInfo" class="text-muted small"></div>
                        <nav aria-label="Suggested courses pagination">
                            <ul class="pagination justify-content-center mb-0" id="suggestedPagination"></ul>
                        </nav>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="enrolled" role="tabpanel" aria-labelledby="enrolled-tab">
                <div class="row g-4" id="enrolledCourses">
                    @if (!Model.Courses.Any(c => c.IsEnrolled))
                    {
                        <div class="col-12">
                            <div class="info-message">
                                <i class="fas fa-info-circle"></i> <span data-i18n-vi="Bạn chưa tham gia khóa học nào." data-i18n-en="You haven't joined any courses yet.">Bạn chưa tham gia khóa học nào.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="modal fade" id="unenrollConfirmModal" tabindex="-1" aria-labelledby="unenrollConfirmModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="unenrollConfirmModalLabel">Xác nhận hủy khóa học</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Bạn có chắc chắn muốn hủy khóa học này không?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Không</button>
                                        <button type="button" class="btn btn-danger" id="confirmUnenrollBtn">Hủy khóa học</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @foreach (var course in Model.Courses.Where(c => c.IsEnrolled))
                        {
                            var formId = $"unenrollForm_{course.CourseId}";
                            <div class="col-md-6 col-lg-3 mb-4 course-item">
                                <div class="course-card h-100 animate__animated animate__fadeInUp" 
                                     data-bs-toggle="popover" 
                                     data-bs-trigger="hover"
                                     data-bs-placement="auto"
                                     data-bs-html="true"
                                     data-course-id="@course.CourseId"
                                     data-course-description="@(course.Description ?? "")"
                                     data-course-instructor="@(course.InstructorName ?? "")"
                                     data-course-lessons="@(course.Lessons?.Count ?? 0)"
                                     data-bs-content="">
                                    <div class="course-image-wrapper">
                                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                                        {
                                            <img src="@course.ImageUrl" class="course-image" alt="@course.CourseName">
                                        }
                                        else
                                        {
                                            <img src="/images/default-course.jpg" class="course-image" alt="Default Image">
                                        }
                                        <div class="course-overlay">
                                            <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn btn-light btn-sm rounded-pill">
                                                <i class="bi bi-eye me-1"></i><span data-i18n-vi="Xem chi tiết" data-i18n-en="View details">Xem chi tiết</span>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="course-rating">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi bi-star-fill text-warning" style="@(i <= Math.Ceiling(course.AverageRating ?? 0) ? "" : "color: #e9ecef;")"></i>
                                                }
                                                <span class="ms-2">@(course.AverageRating.HasValue ? course.AverageRating.Value.ToString("F1") : "Chưa có đánh giá")</span>
                                            </div>
                                        </div>
                                        <h5 class="card-title mb-2">@course.CourseName</h5>
                                        <p class="card-text text-muted description-text">@course.Description</p>
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            @if (!string.IsNullOrWhiteSpace(course.Level))
                                            {
                                                <span class="badge bg-light text-primary border">@course.Level</span>
                                            }
                                            @if (course.DurationMinutes.HasValue)
                                            {
                                                <span class="badge bg-info-subtle text-info"><i class="bi bi-clock me-1"></i>@course.DurationMinutes.Value phút</span>
                                            }
                                            @foreach (var tag in course.TagNames ?? new List<string>())
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">@tag</span>
                                            }
                                        </div>
                                        <div class="text-muted small mb-2">
                                            <i class="bi bi-clock me-1"></i>@(course.DurationMinutes.HasValue ? $"{course.DurationMinutes} phút" : "Thời lượng linh hoạt")
                                        </div>
                                        <div class="mt-auto pt-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="course-lessons">
                                                    <i class="bi bi-collection me-1"></i>
                                                    <span>@(course.Lessons?.Count ?? 0) <span data-i18n-vi="bài học" data-i18n-en="lessons">bài học</span></span>
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="course-price fw-bold text-primary">
                                                    @(course.Price.HasValue ? $"{course.Price.Value:N0}₫" : "Miễn phí")
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@Url.Action("Details", "Course", new { id = course.CourseId })" class="btn btn-primary btn-sm rounded-pill">
                                                        <i class="bi bi-play-fill me-1"></i><span data-i18n-vi="Vào học" data-i18n-en="Start learning">Vào học</span>
                                                    </a>
                                                    <form asp-action="Unenroll" asp-controller="Enrollment" asp-route-courseId="@course.CourseId" method="post" class="d-inline unenroll-form" id="@formId">
                                                        <input type="hidden" name="__RequestVerificationToken" value="@(ViewData["__RequestVerificationToken"])" />
                                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill btn-unenroll" data-form-id="@formId" title="Hủy khóa học">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Courses.Any(c => c.IsEnrolled))
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div id="enrolledPaginationInfo" class="text-muted small"></div>
                        <nav aria-label="Enrolled courses pagination">
                            <ul class="pagination justify-content-center mb-0" id="enrolledPagination"></ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

        <!-- Forum Section -->
        @if (User.Identity.IsAuthenticated && (Model.Courses.Any(c => c.IsEnrolled) || User.IsInRole("Instructor") || User.IsInRole("Admin")))
        {
            <div class="forum-home-section mt-5 mb-4">
                <div class="row">
                    <div class="col-12">
                        <h4 class="forum-section-title-simple mb-3">
                            <i class="bi bi-chat-dots-fill text-primary me-2"></i>
                            <span data-i18n-vi="Diễn đàn thảo luận" data-i18n-en="Discussion Forum">Diễn đàn thảo luận</span>
                        </h4>
                        <div class="row g-3">
                            @foreach (var course in Model.Courses.Where(c => c.IsEnrolled).Take(3))
                            {
                                <div class="col-md-4 col-lg-3">
                                    <a href="@Url.Action("Index", "Forum", new { courseId = course.CourseId })" class="forum-course-link">
                                        <div class="forum-course-card">
                                            <div class="forum-course-icon">
                                                <i class="bi bi-book-fill"></i>
                                            </div>
                                            <div class="forum-course-info">
                                                <h6 class="forum-course-name">@course.CourseName</h6>
                                                <p class="forum-course-desc" data-i18n-vi="Thảo luận về khóa học" data-i18n-en="Discuss about this course">Thảo luận về khóa học</p>
                                            </div>
                                            <div class="forum-course-arrow">
                                                <i class="bi bi-chevron-right"></i>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                            @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                            {
                                <div class="col-md-4 col-lg-3">
                                    <a href="@Url.Action("Index", "Forum", new { courseId = Model.Courses.FirstOrDefault()?.CourseId })" class="forum-course-link">
                                        <div class="forum-course-card forum-course-card-admin">
                                            <div class="forum-course-icon">
                                                <i class="bi bi-shield-check-fill"></i>
                                            </div>
                                            <div class="forum-course-info">
                                                <h6 class="forum-course-name" data-i18n-vi="Quản lý diễn đàn" data-i18n-en="Manage Forum">Quản lý diễn đàn</h6>
                                                <p class="forum-course-desc" data-i18n-vi="Xem và quản lý tất cả diễn đàn" data-i18n-en="View and manage all forums">Xem và quản lý tất cả diễn đàn</p>
                                            </div>
                                            <div class="forum-course-arrow">
                                                <i class="bi bi-chevron-right"></i>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row mt-5 pt-4 border-top">
            <div class="col-12 text-center mb-4">
                <h2 class="section-title" data-i18n-vi="Tại sao chọn E-Learning System?" data-i18n-en="Why choose E-Learning System?">Tại sao chọn E-Learning System?</h2>
                <p class="section-subtitle text-muted" data-i18n-vi="Chúng tôi mang đến trải nghiệm học tập tốt nhất cho bạn." data-i18n-en="We bring the best learning experience for you.">Chúng tôi mang đến trải nghiệm học tập tốt nhất cho bạn.</p>
            </div>

            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-award"></i>
                    </div>
                    <h5 class="feature-title" data-i18n-vi="Nội dung chất lượng" data-i18n-en="Quality content">Nội dung chất lượng</h5>
                    <p class="text-muted" data-i18n-vi="Bài giảng được biên soạn bởi các chuyên gia hàng đầu trong ngành, đảm bảo tính chính xác và cập nhật." data-i18n-en="Lessons are created by leading experts to ensure accuracy and updates.">Bài giảng được biên soạn bởi các chuyên gia hàng đầu trong ngành, đảm bảo tính chính xác và cập nhật.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h5 class="feature-title" data-i18n-vi="Học mọi lúc, mọi nơi" data-i18n-en="Learn anytime, anywhere">Học mọi lúc, mọi nơi</h5>
