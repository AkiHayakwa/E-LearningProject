@model LearningManagementSystem.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - E-Learning System";
    Layout = "_Layout";
}

<!-- Hero Section -->
<div class="hero-section position-relative">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="promo-box bg-white p-4 shadow-sm" style="border-radius: 8px;">
                    @if (Model.User != null)
                    {
                        <h1 class="display-4 fw-bold">Chào mừng, @Model.User.FullName!</h1>
                        <p class="lead mt-3">
                            Bạn đang đăng nhập với vai trò: <strong>@(Model.User.Role != null ? Model.User.Role.RoleName : "Không xác định")</strong>.
                            Học các kỹ năng bạn cần để thành công trong thế kỷ 21 - từ lập trình cơ bản đến các khóa học chuyên sâu.
                            Các khóa học giá từ <strong>299.000 đ</strong>. Ưu đãi sẽ kết thúc hôm nay.
                        </p>
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger">Đăng xuất</a>
                    }
                    else
                    {
                        <h1 class="display-4 fw-bold">Không ngừng phá <br />n đảo u</h1>
                        <p class="lead mt-3">
                            Học các kỹ năng bạn cần để thành công trong thế kỷ 21 - từ lập trình cơ bản đến các khóa học chuyên sâu.
                            Các khóa học giá từ <strong>299.000 đ</strong>. Ưu đãi sẽ kết thúc hôm nay.
                        </p>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary me-2">Đăng nhập để bắt đầu</a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary">Đăng ký ngay</a>
                    }
                </div>
            </div>
            <div class="col-md-6 text-center">
                <img src="/images/student.jpg" alt="Người học" class="img-fluid" style="max-height: 500px;" />
            </div>
        </div>
    </div>
</div>

<!-- Partner Logos -->
<div class="partner-logos py-5">
    <div class="container text-center">
        <p class="text-muted mb-4">Được hơn 16.000 công ty và hàng triệu học viên trên khắp thế giới tin dùng</p>
        <div class="d-flex justify-content-center flex-wrap gap-5">
            <img src="/images/volkswagen.png" alt="Volkswagen" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/samsung.png" alt="Samsung" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/cisco.png" alt="Cisco" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/vimeo.png" alt="Vimeo" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/p-and-g.png" alt="P&G" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/hewlett-packard.png" alt="Hewlett Packard" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/citi.png" alt="Citi" class="img-fluid" style="max-height: 50px;" />
            <img src="/images/ericsson.png" alt="Ericsson" class="img-fluid" style="max-height: 50px;" />
        </div>
    </div>
</div>

<!-- Học viên đang xem -->
<div class="container py-5">
    <h2 class="mb-4">Học viên đang xem</h2>
    @if (Model.Courses != null && Model.Courses.Any())
    {
        <div class="row">
            @foreach (var course in Model.Courses)
            {
                <div class="col-md-3 mb-4">
                    <div class="card shadow-sm">
                        <img src="@(string.IsNullOrEmpty(course.ImageUrl) ? "/images/default-course.jpg" : course.ImageUrl)" class="card-img-top" alt="@course.CourseName" />
                        <div class="card-body">
                            <h5 class="card-title">@course.CourseName</h5>
                            <p class="card-text text-muted">Ngày tạo: @course.CreatedDate.ToString("dd/MM/yyyy")</p>
                            <p class="card-text">299.000 đ</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Không có khóa học nào để hiển thị.</p>
    }
</div>

@section Styles {
    <style>
        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, #f7d02c, #f7d02c 50%, #fff 50%, #fff);
            padding: 5rem 0;
            min-height: 500px;
        }

        .promo-box {
            max-width: 500px;
        }

            .promo-box h1 {
                font-size: 3rem;
                line-height: 1.2;
            }

            .promo-box p {
                font-size: 1.1rem;
            }

        /* Partner Logos */
        .partner-logos {
            background-color: #f8f9fa;
        }

            .partner-logos img {
                filter: grayscale(100%);
                transition: filter 0.3s ease;
            }

                .partner-logos img:hover {
                    filter: grayscale(0%);
                }

        /* Card Styling */
        .card {
            border: none;
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
            }

        .card-img-top {
            height: 200px;
            object-fit: cover;
        }
    </style>
}