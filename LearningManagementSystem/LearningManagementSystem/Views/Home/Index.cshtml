@section Scripts {
    <script src="~/js/Home/Home.js?v=2"></script>

    <script>
        let formToSubmit = null;
        document.querySelectorAll('.btn-unenroll').forEach(function(btn) {
            btn.addEventListener('click', function() {
                formToSubmit = document.getElementById(this.getAttribute('data-form-id'));
                var modal = new bootstrap.Modal(document.getElementById('unenrollConfirmModal'));
                modal.show();
            });
        });
        document.getElementById('confirmUnenrollBtn').addEventListener('click', function() {
            if (formToSubmit) {
                formToSubmit.submit();
            }
        });

        // Initialize popovers for course cards
        function initializePopovers() {
            // Kiểm tra xem Bootstrap đã load chưa
            if (typeof bootstrap === 'undefined') {
                console.warn('Bootstrap chưa được load, đợi thêm...');
                setTimeout(initializePopovers, 100);
                return;
            }

            // Helper function to escape HTML
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            const courseCards = document.querySelectorAll('.course-card[data-bs-toggle="popover"]');
            courseCards.forEach(function (card) {
                // Kiểm tra xem popover đã được khởi tạo chưa
                const existingPopover = bootstrap.Popover.getInstance(card);
                if (existingPopover) {
                    existingPopover.dispose();
                }

                const description = card.getAttribute('data-course-description') || '';
                const instructor = card.getAttribute('data-course-instructor') || '';
                const lessons = card.getAttribute('data-course-lessons') || '0';
                
                // Hiển thị đầy đủ mô tả trong popover
                let descText = description;
                
                // Escape HTML to prevent XSS
                const safeDesc = escapeHtml(descText);
                const safeInstructor = instructor ? escapeHtml(instructor.trim()) : 'Chưa có';
                
                const popoverContent = `
                    <div class="course-popover-content" style="max-width: 350px; max-height: 400px; overflow-y: auto;">
                        <p class="mb-2 small"><strong>Mô tả:</strong> ${safeDesc}</p>
                        <p class="mb-2 small"><strong>Giảng viên:</strong> ${safeInstructor}</p>
                        <p class="mb-0 small"><strong>Số bài học:</strong> ${lessons} bài</p>
                    </div>
                `;
                
                card.setAttribute('data-bs-content', popoverContent);
                
                try {
                    const popover = new bootstrap.Popover(card, {
                        trigger: 'hover focus',
                        placement: 'auto',
                        html: true,
                        container: 'body',
                        delay: { show: 300, hide: 100 },
                        fallbackPlacements: ['top', 'bottom', 'left', 'right']
                    });
                } catch (error) {
                    console.error('Lỗi khi khởi tạo popover:', error);
                }
            });
        }

        // Khởi tạo khi DOM ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializePopovers);
        } else {
            // DOM đã sẵn sàng
            initializePopovers();
        }

        // Khởi tạo lại khi có thay đổi nội dung (pagination, filter, etc.)
        document.addEventListener('popover:reinit', initializePopovers);

        // Khởi tạo lại popover khi chuyển tab
        const courseTabs = document.getElementById('courseTabs');
        if (courseTabs) {
            courseTabs.addEventListener('shown.bs.tab', function() {
                // Đợi một chút để đảm bảo DOM đã được cập nhật
                setTimeout(initializePopovers, 100);
            });
        }

        // Khởi tạo lại popover sau khi pagination thay đổi
        // Sử dụng MutationObserver để theo dõi thay đổi trong course list
        const observer = new MutationObserver(function(mutations) {
            let shouldReinit = false;
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                    shouldReinit = true;
                }
            });
            if (shouldReinit) {
                setTimeout(initializePopovers, 100);
            }
        });

        // Quan sát các thay đổi trong suggested và enrolled courses
        const suggestedCourses = document.getElementById('suggestedCourses');
        const enrolledCourses = document.getElementById('enrolledCourses');
        if (suggestedCourses) {
            observer.observe(suggestedCourses, {
                attributes: true,
                subtree: true,
                attributeFilter: ['style']
            });
        }
        if (enrolledCourses) {
            observer.observe(enrolledCourses, {
                attributes: true,
                subtree: true,
                attributeFilter: ['style']
            });
        }
    </script>
}

