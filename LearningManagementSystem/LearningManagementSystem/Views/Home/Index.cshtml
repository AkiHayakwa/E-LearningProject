@section Scripts {
    <script>
        let selectedCourseId = '';

        // Hàm lấy chi tiết khóa học và bình luận thông qua AJAX
        function getCourseDetails(courseId) {
            selectedCourseId = courseId;
            document.getElementById('commentCourseId').value = courseId;

            // Lấy chi tiết khóa học
            fetch(`/Course/GetCourseDetails/${courseId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data) {
                    document.getElementById('courseTitle').innerText = data.title;
                    document.getElementById('courseDescription').innerText = data.description || 'Không có mô tả';
                    document.getElementById('courseCreatedDate').innerText = data.createdDate ? new Date(data.createdDate).toLocaleDateString('vi-VN') : 'Không có';
                }
