@model LearningManagementSystem.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - E-Learning System";
    Layout = "_Layout";
}

<!-- Hero Section -->
<div class="hero-section position-relative">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="promo-box bg-white p-4 shadow-sm" style="border-radius: 8px;">
                    @if (Model.User != null)
                    {
                        <h1 class="display-4 fw-bold">Chào mừng, @Model.User.FullName!</h1>
                        <p class="lead mt-3">
                            Bạn đang đăng nhập với vai trò: <strong>@(Model.User.Role != null ? Model.User.Role.RoleName : "Không xác định")</strong>.<br />
                            Khám phá các khóa học miễn phí để nâng cao kỹ năng của bạn - từ lập trình cơ bản đến các khóa học chuyên sâu.
                        </p>
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger">Đăng xuất</a>
                    }
                    else
                    {
                        <h1 class="display-4 fw-bold">Học tập miễn phí <br />mọi lúc, mọi nơi</h1>
                        <p class="lead mt-3">
                            Khám phá các khóa học miễn phí để nâng cao kỹ năng của bạn - từ lập trình cơ bản đến các khóa học chuyên sâu.
                        </p>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary me-2">Đăng nhập để bắt đầu</a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary">Đăng ký ngay</a>
                    }
                </div>
            </div>
            <div class="col-md-6 text-center">
                <img src="/images/student.jpg" alt="Người học" class="img-fluid" style="max-height: 500px;" />
            </div>
        </div>
    </div>
</div>

<!-- Danh sách khóa học -->
<div class="container py-5">
    <h2 class="mb-4">Danh sách khóa học</h2>
    @if (Model.Courses != null && Model.Courses.Any())
    {
        <div class="row">
            @foreach (var course in Model.Courses)
            {
                <div class="col-md-3 mb-4">
                    <div class="card shadow-sm">
                        <img src="@(string.IsNullOrEmpty(course.ImageUrl) ? "/images/default-course.jpg" : course.ImageUrl)" class="card-img-top" alt="@course.CourseName" />
                        <div class="card-body">
                            <h5 class="card-title">@course.CourseName</h5>
                            <p class="card-text text-muted">Ngày tạo: @course.CreatedDate.ToString("dd/MM/yyyy")</p>
                            @if (User.Identity.IsAuthenticated)
                            {
                                if (course.IsEnrolled)
                                {
                                    <button class="btn btn-danger w-100" disabled>Đã đăng ký</button>
                                }
                                else
                                {
                                    <form asp-action="Enroll" asp-controller="Course" asp-route-id="@course.CourseId" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success w-100">Đăng ký</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account")" class="btn btn-success w-100">Đăng ký</a>
                            }
                            <a href="@Url.Action("CourseDetails", "Course", new { id = course.CourseId })" class="btn btn-primary btn-sm mt-2">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Không có khóa học nào để hiển thị.</p>
    }
</div>

@section Styles {
    <style>
        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, #f7d02c, #f7d02c 50%, #fff 50%, #fff);
            padding: 5rem 0;
            min-height: 500px;
        }

        .promo-box {
            max-width: 500px;
        }

            .promo-box h1 {
                font-size: 3rem;
                line-height: 1.2;
            }

            .promo-box p {
                font-size: 1.1rem;
            }

        /* Partner Logos */
        .partner-logos {
            background-color: #f8f9fa;
        }

            .partner-logos img {
                filter: grayscale(100%);
                transition: filter 0.3s ease;
            }

                .partner-logos img:hover {
                    filter: grayscale(0%);
                }

        /* Card Styling */
        .card {
            border: none;
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
            }

        .card-img-top {
            height: 200px;
            object-fit: cover;
        }

        /* Button Styling */
        .btn-success {
            background-color: #28a745;
            border-color: #28a745;
        }

            .btn-success:hover {
                background-color: #218838;
                border-color: #1e7e34;
            }

        .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
        }

            .btn-danger:hover {
                background-color: #c82333;
                border-color: #bd2130;
            }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

            .btn-primary:hover {
                background-color: #0056b3;
                border-color: #004085;
            }
    </style>
}