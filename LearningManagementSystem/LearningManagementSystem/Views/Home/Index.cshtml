@model LearningManagementSystem.Models.ViewModels.HomeViewModel
@using System.Linq
@using Newtonsoft.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trang chủ - E-Learning System";
}

<style>
    .welcome-section {
        background: linear-gradient(135deg, #1a73e8, #4285f4);
        color: #ffffff;
        padding: 3rem;
        border-radius: 10px;
        margin-bottom: 2rem;
    }

    .course-card {
        transition: transform 0.3s;
        cursor: pointer;
    }

        .course-card:hover {
            transform: translateY(-5px);
        }

    .section-title {
        color: #1a73e8;
        border-bottom: 2px solid #1a73e8;
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .comment-card {
        background-color: #f8f9fa;
        border-left: 4px solid #1a73e8;
    }

    .comment-section {
        max-height: 200px;
        overflow-y: auto;
        margin-bottom: 1rem;
    }

    .comment-item {
        border-bottom: 1px solid #ddd;
        padding: 0.5rem 0;
    }
</style>

<!-- Hiển thị thông báo thành công hoặc lỗi -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Phần chào mừng -->
<div class="welcome-section text-center">
    <h1 class="display-4">Chào mừng, @Model.User.FullName!</h1>
    <p class="lead">Bạn đang đăng nhập với vai trò: <strong>@Model.User.Roles.RoleName</strong></p>
    <a href="/Account/Logout" class="btn btn-light">Đăng xuất</a>
</div>

<!-- Đăng ký khóa học -->
<div class="mb-5">
    <h2 class="section-title">Đăng ký khóa học</h2>
    @{
        // Lấy danh sách các khóa học có sẵn từ cơ sở dữ liệu
        var availableCourses = ViewBag.AvailableCourses as IEnumerable<LearningManagementSystem.Models.Course>;
    }
    @if (availableCourses != null && availableCourses.Any())
    {
        <div class="row">
            @foreach (var course in availableCourses)
            {
                <div class="col-md-4 mb-4">
                    <div class="card course-card shadow-sm" data-bs-toggle="modal" data-bs-target="#courseDetailModal"
                         onclick="getCourseDetails('@course.CourseId')">
                        <div class="card-body">
                            <h5 class="card-title" style="color: #333;">@course.CourseName</h5>
                            <p class="card-text" style="color: #666;">Ngày tạo: @(course.CreatedDate.ToString("dd/MM/yyyy") ?? "Không có")</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Không có khóa học nào để đăng ký.</p>
    }
</div>

<!-- Khóa học đã đăng ký -->
<div class="mb-5">
    <h2 class="section-title">Khóa học đã đăng ký</h2>
    @if (Model.Enrollments.Any())
    {
        <div class="row">
            @foreach (var enrollment in Model.Enrollments)
            {
                <div class="col-md-4 mb-4">
                    <div class="card course-card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title" style="color: #333;">@enrollment.Course.CourseName</h5>
                            <p class="card-text" style="color: #666;">Ngày đăng ký: @enrollment.EnrollmentDate.ToString("dd/MM/yyyy")</p>
                            <a href="@Url.Action("Index", "Progress", new { courseId = enrollment.CourseId })" class="btn btn-primary" style="background-color: #1a73e8; border: none;">Xem tiến độ</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Bạn chưa đăng ký khóa học nào. <a href="@Url.Action("Courses", "Home")" class="btn btn-success">Đăng ký khóa học</a></p>
    }
</div>

<!-- Tiến độ học tập gần đây -->
<div class="mb-5">
    <h2 class="section-title">Tiến độ học tập gần đây</h2>
    @if (Model.Progresses.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Khóa học</th>
                    <th>Bài học</th>
                    <th>Trạng thái</th>
                    <th>Ngày hoàn thành</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var progress in Model.Progresses)
                {
                    <tr class="@(progress.CompletionStatus ? "table-success" : "")">
                        <td style="color: #333;">@progress.Lesson.Course.CourseName</td>
                        <td style="color: #333;">@progress.Lesson.LessonTitle</td>
                        <td style="color: #666;">@(progress.CompletionStatus ? "Hoàn thành" : "Chưa hoàn thành")</td>
                        <td style="color: #666;">@(progress.CompletionDate?.ToString("dd/MM/yyyy") ?? "Chưa có")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Bạn chưa có tiến độ học tập nào.</p>
    }
</div>

<!-- Bình luận gần đây -->
<div class="mb-5">
    <h2 class="section-title">Bình luận gần đây</h2>
    @if (Model.Comments.Any())
    {
        <div class="row">
            @foreach (var comment in Model.Comments)
            {
                <div class="col-md-6 mb-3">
                    <div class="card comment-card p-3">
                        <p class="mb-1" style="color: #333;"><strong>@comment.User.FullName</strong> đã bình luận trong <strong>@comment.Lesson.LessonTitle</strong> (Khóa học: @comment.Lesson.Course.CourseName)</p>
                        <p class="mb-1" style="color: #666;">@comment.Content</p>
                        <small class="text-muted">Đăng vào: @comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Chưa có bình luận nào.</p>
    }
</div>

<!-- Modal chi tiết khóa học -->
<div class="modal fade" id="courseDetailModal" tabindex="-1" aria-labelledby="courseDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="courseDetailModalLabel">Chi tiết khóa học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h5 id="courseTitle"></h5>
                <p><strong>Mô tả:</strong> <span id="courseDescription"></span></p>
                <p><strong>Giảng viên:</strong> <span id="courseInstructor"></span></p>
                <p><strong>Ngày tạo:</strong> <span id="courseCreatedDate"></span></p>

                <!-- Phần bình luận -->
                <hr />
                <h6>Bình luận</h6>
                <div class="comment-section" id="commentSection">
                    <!-- Bình luận sẽ được tải bằng AJAX -->
                </div>

                <!-- Form thêm bình luận -->
                <form id="commentForm" onsubmit="addComment(event)">
                    <div class="mb-3">
                        <label for="commentContent" class="form-label">Thêm bình luận:</label>
                        <textarea class="form-control" id="commentContent" name="content" rows="3" required></textarea>
                    </div>
                    <input type="hidden" id="commentCourseId" name="courseId" />
                    <input type="hidden" id="commentLessonId" name="lessonId" value="default-lesson-id" /> <!-- Giả định lessonId mặc định -->
                    <button type="submit" class="btn btn-primary">Gửi bình luận</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="enrollButton" onclick="showConfirmModal()">Đăng ký khóa học</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận đăng ký -->
<div class="modal fade" id="confirmEnrollModal" tabindex="-1" aria-labelledby="confirmEnrollModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmEnrollModalLabel">Xác nhận đăng ký</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn đăng ký khóa học này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form id="enrollForm" asp-action="Enroll" asp-controller="Enrollment" method="post" style="display:inline;">
                    <input type="hidden" name="id" id="enrollCourseId" />
                    <button type="submit" class="btn btn-primary">Xác nhận</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedCourseId = '';

        // Hàm lấy chi tiết khóa học và bình luận thông qua AJAX
        function getCourseDetails(courseId) {
            selectedCourseId = courseId;
            document.getElementById('commentCourseId').value = courseId;

            // Lấy chi tiết khóa học
            fetch(`/Course/GetCourseDetails/${courseId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data) {
                    document.getElementById('courseTitle').innerText = data.title;
                    document.getElementById('courseDescription').innerText = data.description || 'Không có mô tả';
                    document.getElementById('courseInstructor').innerText = data.instructor || 'Không có thông tin';
                    document.getElementById('courseCreatedDate').innerText = data.createdDate ? new Date(data.createdDate).toLocaleDateString('vi-VN') : 'Không có';
                }
            })
            .catch(error => {
                console.error('Lỗi khi lấy chi tiết khóa học:', error);
                alert('Đã có lỗi xảy ra khi lấy thông tin khóa học.');
            });

            // Lấy danh sách bình luận
            fetch(`/Comment/GetCommentsByCourse?courseId=${courseId}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => response.json())
            .then(comments => {
                const commentSection = document.getElementById('commentSection');
                commentSection.innerHTML = '';
                if (comments && comments.length > 0) {
                    comments.forEach(comment => {
                        const commentDiv = document.createElement('div');
                        commentDiv.className = 'comment-item';
                        commentDiv.innerHTML = `
                            <p class="mb-1"><strong>${comment.userName}</strong> (${comment.lessonTitle}): ${comment.content}</p>
                            <small class="text-muted">Đăng vào: ${comment.createdDate}</small>
                        `;
                        commentSection.appendChild(commentDiv);
                    });
                } else {
                    commentSection.innerHTML = '<p class="text-muted">Chưa có bình luận nào.</p>';
                }
            })
            .catch(error => {
                console.error('Lỗi khi lấy bình luận:', error);
                document.getElementById('commentSection').innerHTML = '<p class="text-danger">Đã có lỗi xảy ra khi lấy bình luận.</p>';
            });
        }

        // Hàm hiển thị modal xác nhận đăng ký
        function showConfirmModal() {
            document.getElementById('enrollCourseId').value = selectedCourseId;
            var confirmModal = new bootstrap.Modal(document.getElementById('confirmEnrollModal'));
            confirmModal.show();
        }

        // Hàm thêm bình luận
        function addComment(event) {
            event.preventDefault();
            const form = document.getElementById('commentForm');
            const formData = new FormData(form);

            fetch('/Comment/AddComment', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    // Làm mới danh sách bình luận
                    getCourseDetails(selectedCourseId);
                    // Xóa nội dung textarea
                    document.getElementById('commentContent').value = '';
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Lỗi khi thêm bình luận:', error);
                alert('Đã có lỗi xảy ra khi thêm bình luận.');
            });
        }
    </script>
}