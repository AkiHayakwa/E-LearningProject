@model IEnumerable<LearningManagementSystem.Models.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Xác nhận thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalPrice = Model.Sum(ci => ci.CartItem.Price);
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
                <h2 class="mb-4 text-dark fw-bold" data-i18n-vi="Xác nhận thanh toán" data-i18n-en="Confirm payment">Xác nhận thanh toán</h2>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        @TempData["Error"]
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["Success"]
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-cart-container text-center py-5 my-4 bg-light rounded-4 shadow-sm">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h3 class="mt-4 mb-3" data-i18n-vi="Giỏ hàng của bạn hiện đang trống" data-i18n-en="Your cart is currently empty">Giỏ hàng của bạn hiện đang trống</h3>
            <p class="text-muted mb-4" data-i18n-vi="Hãy thêm các khóa học yêu thích vào giỏ hàng" data-i18n-en="Add your favorite courses to the cart.">Hãy thêm các khóa học yêu thích vào giỏ hàng</p>
            <a href="@Url.Action("Index", "Search")" class="btn btn-primary btn-lg px-4 py-2 rounded-pill">
                <i class="bi bi-search me-2"></i><span data-i18n-vi="Khám phá khóa học ngay" data-i18n-en="Explore courses now">Khám phá khóa học ngay</span>
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm mb-4">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-collection me-2"></i><span data-i18n-vi="Danh sách khóa học" data-i18n-en="Course list">Danh sách khóa học</span>
                            </h5>
                        <span class="badge bg-primary rounded-pill">@Model.Count() <span data-i18n-vi="khóa học" data-i18n-en="courses">khóa học</span></span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="cart-items">
                            @foreach (var item in Model)
                            {
                                <div class="cart-item mb-3">
                                    <div class="p-3 rounded-4 bg-light">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <div class="img-container rounded-3 overflow-hidden">
                                                    <img src="@(string.IsNullOrEmpty(item.CartItem.Course.ImageUrl) ? "/images/default-course.jpg" : item.CartItem.Course.ImageUrl)"
                                                         alt="@item.CartItem.Course.CourseName"
                                                         class="img-fluid w-100 h-100 object-fit-cover"
                                                         style="height: 100px; object-fit: cover;" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <h6 class="fw-bold mb-1">@item.CartItem.Course.CourseName</h6>
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="bi bi-person-circle text-muted me-2"></i>
                                                    <span class="text-muted small">@item.InstructorName</span>
                                                </div>
                                            </div>
                                            <div class="col-md-3 text-end">
                                                <div class="fw-bold fs-5 text-primary">₫@item.CartItem.Price.ToString("N0")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-receipt me-2"></i><span data-i18n-vi="Thông tin thanh toán" data-i18n-en="Payment information">Thông tin thanh toán</span>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="summary-item d-flex justify-content-between mb-3">
                            <span class="text-muted" data-i18n-vi="Tổng tiền khóa học" data-i18n-en="Course total">Tổng tiền khóa học</span>
                            <span>₫@totalPrice.ToString("N0")</span>
                        </div>

                        <div class="summary-item d-flex justify-content-between mb-3">
                            <span class="text-muted" data-i18n-vi="Thuế" data-i18n-en="Tax">Thuế</span>
                            <span>₫0</span>
                        </div>

                        <hr class="my-4">

                        <div class="summary-total d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold fs-5" data-i18n-vi="Tổng thanh toán" data-i18n-en="Total payment">Tổng thanh toán</span>
                            <span class="fw-bold fs-4 text-primary">₫@totalPrice.ToString("N0")</span>
                        </div>

                        <form asp-action="InitiateVnpayPayment" asp-controller="Cart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="amount" value="@((int)totalPrice)" />
                            <input type="hidden" name="selectedCartItemIds" value="@string.Join(",", Model.Select(item => item.CartItem.CartItemId))" />
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill mb-3">
                                <div class="d-flex align-items-center justify-content-center">
                                    <span class="me-2" data-i18n-vi="Thanh toán qua VNPay" data-i18n-en="Pay via VNPay">Thanh toán qua VNPay</span>
                                    <i class="bi bi-credit-card-2-front"></i>
                                </div>
                            </button>
                        </form>

                        <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary w-100 py-2 rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i><span data-i18n-vi="Quay lại giỏ hàng" data-i18n-en="Back to cart">Quay lại giỏ hàng</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Cart/ConfirmPayment.css" />
}