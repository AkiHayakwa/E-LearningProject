@model IEnumerable<LearningManagementSystem.Models.Notification>

@{
    ViewData["Title"] = "Thông báo của bạn - E-Learning System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="notification-header text-center mb-5">
        <h2 class="animate__animated animate__fadeIn" data-i18n-vi="Thông báo của bạn" data-i18n-en="Your notifications">Thông báo của bạn</h2>
        <p class="text-muted animate__animated animate__fadeIn animate__delay-1s" data-i18n-vi="Quản lý và theo dõi các thông báo quan trọng" data-i18n-en="Manage and track important notifications">Quản lý và theo dõi các thông báo quan trọng</p>
    </div>

    <!-- Thông báo hệ thống -->
    <div id="systemAlerts">
        @if (TempData["Success"] != null)
        {
            <div class="alert-wrapper animate__animated animate__fadeInDown">
                <div class="alert alert-success d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-wrapper animate__animated animate__fadeInDown">
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Thống kê thông báo -->
    @if (Model != null && Model.Any())
    {
        @Html.AntiForgeryToken()
        <div class="notification-stats d-flex justify-content-between mb-4 animate__animated animate__fadeIn animate__delay-1s">
            <div class="stat-card">
                <div class="stat-value">@(ViewBag.TotalCount ?? Model.Count())</div>
                <div class="stat-label" data-i18n-vi="Tổng thông báo" data-i18n-en="Total notifications">Tổng thông báo</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@(ViewBag.UnreadCount ?? Model.Count(n => !n.IsRead))</div>
                <div class="stat-label" data-i18n-vi="Chưa đọc" data-i18n-en="Unread">Chưa đọc</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@(ViewBag.TotalCount != null ? (ViewBag.TotalCount - ViewBag.UnreadCount) : Model.Count(n => n.IsRead))</div>
                <div class="stat-label" data-i18n-vi="Đã đọc" data-i18n-en="Read">Đã đọc</div>
            </div>
            @if ((ViewBag.UnreadCount ?? Model.Count(n => !n.IsRead)) > 0)
            {
                <div class="ms-auto stat-action">
                    <form asp-action="MarkAllAsRead" asp-controller="Notification" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-check2-all me-2"></i><span data-i18n-vi="Đánh dấu tất cả đã đọc" data-i18n-en="Mark all as read">Đánh dấu tất cả đã đọc</span>
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- Bộ lọc thông báo -->
        <div class="notification-filters mb-4 animate__animated animate__fadeIn animate__delay-2s">
            <div class="btn-group" role="group" aria-label="Notification filters">
                <button type="button" class="btn btn-filter active" data-filter="all" data-i18n-vi="Tất cả" data-i18n-en="All">Tất cả</button>
                <button type="button" class="btn btn-filter" data-filter="unread" data-i18n-vi="Chưa đọc" data-i18n-en="Unread">Chưa đọc</button>
                <button type="button" class="btn btn-filter" data-filter="read" data-i18n-vi="Đã đọc" data-i18n-en="Read">Đã đọc</button>
            </div>
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="form-control" id="searchNotifications" placeholder="Tìm kiếm thông báo..."
                       data-i18n-placeholder-vi="Tìm kiếm thông báo..." data-i18n-placeholder-en="Search notifications...">
            </div>
        </div>

        <!-- Danh sách thông báo -->
        <div class="notifications-container animate__animated animate__fadeIn animate__delay-2s">
            @foreach (var notification in Model)
            {
                <div class="notification-card @(notification.IsRead ? "read" : "unread")" data-id="@notification.NotificationId" data-read="@notification.IsRead.ToString().ToLower()">
                    <div class="notification-status">
                        <div class="status-indicator @(notification.IsRead ? "read" : "unread")"></div>
                    </div>
                    <div class="notification-content">
                        <div class="notification-icon @(notification.IsRead ? "read-icon" : "unread-icon")">
                            <i class="bi @(notification.IsRead ? "bi-bell" : "bi-bell-fill")"></i>
                        </div>
                        <div class="notification-details">
                            <div class="notification-header">
                                <h3 class="notification-title">@notification.Title</h3>
                                <span class="notification-time">
                                    <i class="bi bi-clock me-1"></i>
                                    @notification.CreatedDate.ToString("HH:mm - dd/MM/yyyy")
                                </span>
                            </div>
                            <p class="notification-text">@notification.Content</p>
                        </div>
                    </div>
                    <div class="notification-actions">
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkAsRead" asp-controller="Notification" method="post" class="mark-read-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@notification.NotificationId" />
                                <button type="submit" class="btn btn-mark-read" title="Đánh dấu đã đọc">
                                    <i class="bi bi-check2"></i>
                                    <span class="action-text d-none d-md-inline" data-i18n-vi="Đánh dấu đã đọc" data-i18n-en="Mark as read">Đánh dấu đã đọc</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="read-marker">
                                <i class="bi bi-check2-all"></i>
                                <span class="d-none d-md-inline" data-i18n-vi="Đã đọc" data-i18n-en="Read">Đã đọc</span>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="notification-empty text-center text-muted py-4" style="display:none;"
                 data-i18n-vi="Không có thông báo nào" data-i18n-en="No notifications found.">
                Không có thông báo nào
            </div>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <nav aria-label="Notification pagination" class="notification-pagination mt-5">
                <ul class="pagination justify-content-center pagination-modern">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">
                                <i class="bi bi-chevron-left"></i>
                                <span class="d-none d-sm-inline">Trước</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class="bi bi-chevron-left"></i>
                                <span class="d-none d-sm-inline">Trước</span>
                            </span>
                        </li>
                    }
                    
                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }
                    
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">
                                <span class="d-none d-sm-inline">Sau</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <span class="d-none d-sm-inline">Sau</span>
                                <i class="bi bi-chevron-right"></i>
                            </span>
                        </li>
                    }
                </ul>
                <div class="pagination-info text-center mt-3">
                    <span class="text-muted">
                        Trang <strong>@ViewBag.CurrentPage</strong> / <strong>@ViewBag.TotalPages</strong>
                        (@ViewBag.TotalCount thông báo)
                    </span>
                </div>
            </nav>
        }
    }
    else
    {
        <div class="empty-state animate__animated animate__fadeIn">
            <div class="empty-icon">
                <i class="bi bi-bell-slash"></i>
            </div>
            <h3 data-i18n-vi="Chưa có thông báo nào" data-i18n-en="No notifications yet">Chưa có thông báo nào</h3>
            <p data-i18n-vi="Bạn sẽ nhận được thông báo khi có cập nhật mới về khóa học hoặc hoạt động học tập" data-i18n-en="You'll receive notifications when there are course or learning updates.">Bạn sẽ nhận được thông báo khi có cập nhật mới về khóa học hoặc hoạt động học tập</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">
                <i class="bi bi-house-door me-2"></i><span data-i18n-vi="Quay lại trang chủ" data-i18n-en="Back to homepage">Quay lại trang chủ</span>
            </a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/Notification/Notifications.css" />
}

@section Scripts {
    <script src="~/js/Notification/Notifications.js"></script>
    <script>
        // Xóa sự kiện JS xử lý mark-all-read vì đã dùng form submit
        document.addEventListener('DOMContentLoaded', function () {
            const markAllReadBtn = document.querySelector('.mark-all-read');
            if (markAllReadBtn) {
                markAllReadBtn.replaceWith(markAllReadBtn.cloneNode(true));
            }
        });
    </script>
}