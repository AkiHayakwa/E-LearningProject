@model IEnumerable<LearningManagementSystem.Models.RevenueShare>
@{
    ViewData["Title"] = "Lịch sử thu nhập";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

@section Styles {
    <style>
        :root {
            --theme-primary: #6a11cb;
            --theme-border: #dee2e6;
            --theme-bg-light: #f7f9fa;
        }

        .btn-primary {
            background-color: var(--theme-primary) !important;
            border-color: var(--theme-primary) !important;
        }

        .text-primary {
            color: var(--theme-primary) !important;
        }

        .card {
            border: 1px solid var(--theme-border);
            box-shadow: none;
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid var(--theme-border);
        }

        .table thead th {
            background-color: var(--theme-bg-light);
            border-bottom-width: 1px;
        }

        .table .badge {
            font-size: 0.8rem;
            font-weight: 600;
        }
    </style>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-dark-800">
            <i class="fas fa-chart-line me-2 text-primary"></i>
            @ViewData["Title"]
        </h1>
        <a href="@Url.Action("Index", "Wallet")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Quay lại Ví
        </a>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Khóa học</th>
                                        <th class="text-end">Số tiền</th>
                                        <th class="text-center">Tỷ lệ (%)</th>
                                        <th class="text-center">Loại</th>
                                        <th class="text-end">Ngày nhận</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var revenue in Model.OrderByDescending(r => r.CreatedDate))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@revenue.Course?.CourseName</strong>
                                                <br>
                                                <small class="text-muted">Payment ID: @revenue.PaymentId</small>
                                            </td>
                                            <td class="text-success fw-bold text-end">
                                                +@revenue.Amount.ToString("N0") VNĐ
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info">@revenue.Percentage.ToString("F1")%</span>
                                            </td>
                                            <td class="text-center">
                                                @if (revenue.ShareType == "Instructor")
                                                {
                                                    <span class="badge bg-success">Giảng viên</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Admin</span>
                                                }
                                            </td>
                                            <td class="text-end">@revenue.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-center">
                                                <span class="badge bg-success">Đã nhận</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <th class="text-end">Tổng cộng:</th>
                                        <th class="text-success text-end h5 mb-0">@Model.Sum(r => r.Amount).ToString("N0") VNĐ</th>
                                        <th colspan="4"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có thu nhập nào</h5>
                            <p class="text-muted">Thu nhập sẽ xuất hiện ở đây khi học viên mua khóa học của bạn.</p>
                            <a href="@Url.Action("Index", "Wallet")" class="btn btn-primary">
                                <i class="fas fa-arrow-left"></i> Quay lại ví
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
