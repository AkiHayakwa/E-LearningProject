<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .tag-menu {
            position: relative;
            display: flex;
            align-items: center;
        }

        .tag-menu-toggle {
            border: none;
            background: transparent;
            color: #fff;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0.4rem 0.75rem;
            border-radius: 999px;
            transition: background 0.2s;
        }

        .tag-menu-toggle:hover,
        .tag-menu:hover .tag-menu-toggle,
        .tag-menu.open .tag-menu-toggle {
            background: rgba(255, 255, 255, 0.08);
        }

        .tag-mega-menu {
            position: absolute;
            left: 0;
            top: 100%;
            display: none;
            background: #fff;
            color: #111;
            min-width: 900px;
            max-width: 1200px;
            border-radius: 0.75rem;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.25);
            overflow: hidden;
            z-index: 1100;
            border: 1px solid #e5e7eb;
        }

        .tag-mega-menu::before {
            content: '';
            position: absolute;
            top: -10px;
            left: 0;
            right: 0;
            height: 12px;
            background: transparent;
        }

        .tag-menu.open .tag-mega-menu {
            display: block;
        }

        /* Layout nhiều cột giống hình 1 */
        .tag-mega-columns {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 0;
            padding: 1.5rem;
        }

        .tag-mega-column {
            padding: 0 1rem;
            border-right: 1px solid #e5e7eb;
        }

        .tag-mega-column:last-child {
            border-right: none;
        }

        .tag-mega-column-header {
            font-weight: 700;
            font-size: 0.938rem;
            color: #111827;
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #e5e7eb;
        }

        .tag-mega-column-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .tag-mega-column-list li {
            margin-bottom: 0.5rem;
        }

        .tag-mega-link {
            display: block;
            padding: 0.375rem 0;
            color: #4b5563;
            text-decoration: none;
            font-size: 0.875rem;
            transition: color 0.2s, padding-left 0.2s;
        }

        .tag-mega-link:hover {
            color: #6366f1;
            padding-left: 0.5rem;
        }

        /* Dark theme overrides for mega menu */
        body.dark-theme .tag-mega-menu {
            background: #1f2937;
            color: #e2e8f0;
            border: 1px solid #374151;
            box-shadow: 0 18px 40px rgba(2, 6, 23, 0.8);
        }

        body.dark-theme .tag-mega-column {
            border-right-color: #374151;
        }

        body.dark-theme .tag-mega-column-header {
            color: #f9fafb;
            border-bottom-color: #4b5563;
        }

        body.dark-theme .tag-mega-link {
            color: #9ca3af;
        }

        body.dark-theme .tag-mega-link:hover {
            color: #818cf8;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .footer-columns-tags {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1rem;
        }

        .footer-columns-tags ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-columns-tags a {
            color: #cbd5f5;
            text-decoration: none;
            display: inline-block;
            padding: 0.1rem 0;
        }

        .footer-columns-tags a:hover {
            color: #fff;
        }

        .tag-menu-wrapper {
            position: static !important;
        }

        .tag-menu {
            position: relative;
            display: flex;
            align-items: center;
        }

        /* Đảm bảo menu không bị ẩn */
        .navbar-nav .nav-item.tag-menu-wrapper {
            position: static;
        }

        @@media (max-width: 992px) {
            .tag-mega-menu {
                position: static;
                box-shadow: none;
                min-width: 0;
                width: 100%;
            }

            .tag-mega-columns {
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                padding: 1rem;
            }

            .tag-mega-column {
                padding: 0 0.75rem;
                border-right: none;
                border-bottom: 1px solid #e5e7eb;
                margin-bottom: 1rem;
                padding-bottom: 1rem;
            }

            .tag-mega-column:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    @using Microsoft.EntityFrameworkCore
    @using LearningManagementSystem.Data
    @using LearningManagementSystem.Models
    @using LearningManagementSystem.Repositories
    @inject LMSContext _context
    @inject INotificationRepository _notificationRepository

    @{
        int cartCount = 0;
        List<CartItem> cartItems = new List<CartItem>();
        decimal totalPrice = 0;
        List<Notification> notifications = new List<Notification>();
        string avatarUrl = "/images/default-user.jpg";
        string forumCourseId = null;
        bool showForumLink = false;

        if (User.Identity.IsAuthenticated)
        {
            var userName = User.Identity.Name;

            if (!string.IsNullOrEmpty(userName))
            {
                var user = await _context.Users
                .FirstOrDefaultAsync(u => u.UserName == userName) ??
                await _context.Users
                .FirstOrDefaultAsync(u => u.Email == userName);

                if (user != null)
                {
                    // Fix lỗi đường dẫn avatar nếu nó không bắt đầu bằng /
                    if (!string.IsNullOrEmpty(user.Avatar))
                    {
                        avatarUrl = user.Avatar.StartsWith("/") ? user.Avatar : $"/images/{user.Avatar}";
                    }
                }

                var cart = await _context.Carts
                .Include(c => c.CartItems)
                .ThenInclude(ci => ci.Course)
                .FirstOrDefaultAsync(c => c.UserName == userName);

                if (cart != null)
                {
                    cartItems = cart.CartItems.ToList();
                    cartCount = cartItems.Count;
                    totalPrice = cartItems.Sum(ci => ci.Course.Price ?? 0);
                }

                // Lấy courseId cho forum link
                var isInstructor = User.IsInRole("Instructor") || User.IsInRole("Admin");
                var enrollment = await _context.Enrollments
                    .Where(e => e.UserName == userName)
                    .FirstOrDefaultAsync();
                
                if (enrollment != null)
                {
                    forumCourseId = enrollment.CourseId;
                    showForumLink = true;
                }
                else if (isInstructor)
                {
                    // Nếu là Instructor/Admin, lấy course đầu tiên
                    var firstCourse = await _context.Courses.FirstOrDefaultAsync();
                    if (firstCourse != null)
                    {
                        forumCourseId = firstCourse.CourseId;
                        showForumLink = true;
                    }
                }

                try
                {
                    ViewBag.UnreadCount = await _notificationRepository.GetUnreadCountAsync(userName);
                    ViewBag.Notifications = await _notificationRepository.GetRecentNotificationsAsync(userName, 5);
                }
                catch (Exception)
                {
                    ViewBag.UnreadCount = 0;
                    ViewBag.Notifications = new List<Notification>();
                }
            }
        }
        else
        {
            ViewBag.UnreadCount = 0;
            ViewBag.Notifications = new List<Notification>();
        }
    }

    <div class="app-container">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-graduation-cap"></i>
                    <span>E-Learning</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="home">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" asp-controller="Search" asp-action="Index" id="exploreCoursesLink" data-i18n="courses">
                                <i class="bi bi-collection-play"></i>
                                Khóa học
                            </a>
                        </li>
                        @if (showForumLink && !string.IsNullOrEmpty(forumCourseId))
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1" href="@Url.Action("Index", "Forum", new { courseId = forumCourseId })" data-i18n-vi="Diễn đàn" data-i18n-en="Forum">
                                    <i class="bi bi-chat-dots-fill"></i>
                                    <span data-i18n-vi="Diễn đàn" data-i18n-en="Forum">Diễn đàn</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item d-flex align-items-center">
                            <div class="nav-link p-0">
                                @await Component.InvokeAsync("TagMenu")
                            </div>
                        </li>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard Admin
                                </a>
                            </li>
                        }
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("Instructor")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Dashboard", "Instructor")">
                                    <i class="bi bi-briefcase me-1"></i> Dashboard Instructor
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="search-container flex-grow-1 mx-3">
                        <form id="searchForm" class="search-bar w-100" asp-controller="Search" asp-action="Index" method="get">
                            <input id="searchInput" class="form-control" type="search" name="query" placeholder="Tìm kiếm khóa học..." data-i18n-placeholder="search_placeholder" aria-label="Search" autocomplete="off" />
                            <i class="bi bi-search search-icon"></i>
                            <button id="searchButton" class="btn btn-search" type="submit" data-i18n="search_button">Tìm</button>
                        </form>
                        <div id="searchSuggestions" class="search-suggestions"></div>
                    </div>

                    <div class="navbar-tools d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm language-switch" role="group" aria-label="Language switcher">
                            <button type="button" class="btn btn-outline-secondary lang-btn" data-lang="vi">VI</button>
                            <button type="button" class="btn btn-outline-secondary lang-btn" data-lang="en">EN</button>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm theme-toggle" aria-label="Toggle theme" data-bs-toggle="tooltip" title="Dark / Light mode">
                            <i class="bi bi-moon-fill"></i>
                        </button>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="user-actions d-flex align-items-center">
                            <div class="dropdown">
                                <button class="action-icon" type="button" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-cart"></i>
                                    @if (cartCount > 0)
                                    {
                                        <span id="cartCount" class="badge-counter">@cartCount</span>
                                    }
                                </button>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="cartDropdown" style="width: 320px;">
                                    <div class="dropdown-header">Giỏ hàng</div>
                                    @if (cartItems.Any())
                                    {
                                        foreach (var item in cartItems)
                                        {
                                            <div class="cart-item">
                                                <img class="cart-item-img" src="@(string.IsNullOrEmpty(item.Course.ImageUrl) ? "/images/default-course.jpg" : item.Course.ImageUrl)" alt="@item.Course.CourseName" />
                                                <div>
                                                    <div class="cart-item-title">@item.Course.CourseName</div>
                                                    <div class="cart-item-price">₫@item.Course.Price?.ToString("N0")</div>
                                                </div>
                                            </div>
                                        }
                                        <div class="cart-total">
                                            <span>Tổng cộng:</span>
                                            <span class="cart-total-amount">₫@totalPrice.ToString("N0")</span>
                                        </div>
                                        <a href="@Url.Action("Index", "Cart")" class="btn-cart">Xem giỏ hàng</a>
                                    }
                                    else
                                    {
                                        <div class="empty-state">
                                            <i class="bi bi-cart-x empty-icon"></i>
                                            <p class="empty-text">Giỏ hàng trống</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="dropdown">
                                <button class="action-icon" type="button" id="notificationBell" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell"></i>
                                    @if (ViewBag.UnreadCount > 0)
                                    {
                                        <span class="badge-counter">@ViewBag.UnreadCount</span>
                                    }
                                </button>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationBell" style="width: 360px; max-height: 480px; overflow-y: auto;">
                                    <div class="dropdown-header">Thông báo</div>
                                    @{
                                        var notificationsList = ViewBag.Notifications as List<Notification>;
                                        if (notificationsList != null && notificationsList.Any())
                                        {
                                            foreach (var notification in notificationsList)
                                            {
                                                <div class="notification-item @(notification.IsRead ? "" : "notification-unread")">
                                                    <div class="notification-content">
                                                        <div class="notification-icon">
                                                            <i class="bi bi-bell"></i>
                                                        </div>
                                                        <div class="notification-text">
                                                            <div class="notification-title">@notification.Title</div>
                                                            <div class="notification-message">@notification.Content</div>
                                                            <div class="notification-time">@notification.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            <a href="@Url.Action("Index", "Notification")" class="btn-view-all">Xem tất cả thông báo</a>
                                        }
                                        else
                                        {
                                            <div class="empty-state">
                                                <i class="bi bi-bell-slash empty-icon"></i>
                                                <p class="empty-text">Không có thông báo mới</p>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="dropdown">
                                <div class="avatar-wrapper" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatarUrl" alt="User Avatar" class="avatar" />
                                </div>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("EditProfile", "Account")"><i class="bi bi-person"></i> Thông tin cá nhân</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("History", "Payment")"><i class="bi bi-receipt"></i> Lịch sử mua hàng</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("MyLearning", "Account")"><i class="bi bi-book"></i> Khóa học của tôi</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("AllTests", "Course")"><i class="bi bi-file-earmark-text"></i> Xem tất cả bài kiểm tra</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="user-actions d-flex gap-2">
                            <a class="btn btn-login btn-auth" href="@Url.Action("Login", "Account")">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                            </a>
                            <a class="btn btn-register btn-auth" href="@Url.Action("Register", "Account")">
                                <i class="bi bi-person-plus"></i> Đăng ký
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-6 footer-col">
                        <div class="footer-logo">
                            <i class="fas fa-graduation-cap"></i>
                            <span class="footer-logo-text">E-Learning</span>
                        </div>
                        <p>Hệ thống đào tạo trực tuyến hàng đầu với các khóa học chất lượng cao, đa dạng lĩnh vực, giúp bạn phát triển kỹ năng và kiến thức một cách hiệu quả.</p>
                        <div class="footer-social">
                            <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                            <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 footer-col">
                        <h5>Khám phá</h5>
                        <ul class="footer-links">
                            <li><a href="/"><i class="bi bi-chevron-right"></i> Trang chủ</a></li>
                            <li><a href="/Search/Index"><i class="bi bi-chevron-right"></i> Khóa học</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Giáo viên</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Blog</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Về chúng tôi</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-12 footer-col">
                        <h5>Danh mục</h5>
                        @await Component.InvokeAsync("TagMenu", new { template = "Footer" })
                    </div>
                    <div class="col-lg-4 col-md-6 footer-col mt-4 mt-lg-0">
                        <h5>Liên hệ</h5>
                        <div class="footer-contact">
                            <div class="footer-contact-icon"><i class="bi bi-geo-alt"></i></div>
                            <div class="footer-contact-info">
                                <div class="footer-contact-label">Địa chỉ</div>
                                <p>Số 123 Đường ABC, Quận 1, TP. Hồ Chí Minh, Việt Nam</p>
                            </div>
                        </div>
                        <div class="footer-contact">
                            <div class="footer-contact-icon"><i class="bi bi-envelope"></i></div>
                            <div class="footer-contact-info">
                                <div class="footer-contact-label">Email</div>
                                <p>support@elearning.com</p>
                            </div>
                        </div>
                        <div class="footer-contact">
                            <div class="footer-contact-icon"><i class="bi bi-telephone"></i></div>
                            <div class="footer-contact-info">
                                <div class="footer-contact-label">Điện thoại</div>
                                <p>+84 123 456 789</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    <div class="footer-copyright">
                        © @DateTime.Now.Year E-Learning. Tất cả các quyền được bảo lưu.
                    </div>
                    <div class="footer-payment">
                        <div class="payment-icon"><i class="fab fa-cc-visa"></i></div>
                        <div class="payment-icon"><i class="fab fa-cc-mastercard"></i></div>
                        <div class="payment-icon"><i class="fab fa-cc-paypal"></i></div>
                        <div class="payment-icon"><i class="fab fa-cc-apple-pay"></i></div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tagMenu = document.querySelector('.tag-menu');
            if (!tagMenu) return;
            const toggle = tagMenu.querySelector('.tag-menu-toggle');

            let hideTimer;
            const openMenu = () => {
                if (window.innerWidth < 992) return;
                clearTimeout(hideTimer);
                tagMenu.classList.add('open');
            };
            const scheduleClose = () => {
                if (window.innerWidth < 992) return;
                hideTimer = setTimeout(() => tagMenu.classList.remove('open'), 200);
            };

            tagMenu.addEventListener('mouseenter', openMenu);
            tagMenu.addEventListener('mouseleave', scheduleClose);

            if (toggle) {
                toggle.addEventListener('click', function (e) {
                    if (window.innerWidth < 992) {
                        e.preventDefault();
                        tagMenu.classList.toggle('open');
                    } else {
                        e.preventDefault();
                        if (tagMenu.classList.contains('open')) {
                            tagMenu.classList.remove('open');
                        } else {
                            openMenu();
                        }
                    }
                });
            }

            document.addEventListener('click', (e) => {
                if (window.innerWidth >= 992) return;
                if (!tagMenu.contains(e.target)) {
                    tagMenu.classList.remove('open');
                }
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>