@model IDictionary<string, List<LearningManagementSystem.Models.Tag>>

<div class="tag-menu">
    <button class="tag-menu-toggle nav-link" type="button">
        <i class="bi bi-grid"></i>
        Khám phá
    </button>
    <div class="tag-mega-menu">
        <div class="tag-mega-columns">
            @if (Model != null && Model.Any())
            {
                @foreach (var group in Model)
                {
                    <div class="tag-mega-column">
                        <div class="tag-mega-column-header">@group.Key</div>
                        @if (group.Value != null && group.Value.Any())
                        {
                            <ul class="tag-mega-column-list">
                                @foreach (var tag in group.Value)
                                {
                                    <li>
                                        <a href="@Url.Action("Index", "Search", new { tagIds = tag.TagId })" class="tag-mega-link">
                                            @tag.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted small">Không có tag</div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-muted small px-3 py-2">Chưa có tag hoạt động.</div>
            }
        </div>
    </div>
</div>

