@using LearningManagementSystem.Models
@{
    ViewData["Title"] = ViewBag.Topic?.Title ?? "Chi tiết chủ đề";
    Layout = "_Layout";
    var topic = ViewBag.Topic as LearningManagementSystem.Models.Topic;
    var posts = ViewBag.Posts as List<LearningManagementSystem.Models.Post>;
    var userName = ViewBag.UserName as string;
    var isInstructor = ViewBag.IsInstructor as bool? ?? false;
    var isTopicOwner = ViewBag.IsTopicOwner as bool? ?? false;
}

<div class="forum-container">
    <div class="container-fluid px-4 py-4">
        <div class="row g-4">
            <!-- Left Sidebar -->
            <div class="col-lg-3 col-md-4">
                <div class="forum-sidebar">
                    <!-- Navigation Menu -->
                    <div class="sidebar-section mb-4">
                        <div class="sidebar-nav-item @(ViewBag.Sort == "newest" || ViewBag.Sort == null ? "active" : "")">
                            <a href="@Url.Action("Index", "Forum", new { courseId = topic?.Forum?.CourseId, sort = "newest" })" class="nav-link-item">
                                <i class="bi bi-stars"></i>
                                <span data-i18n-vi="Mới nhất" data-i18n-en="Newest and Recent">Mới nhất</span>
                            </a>
                        </div>
                        <div class="sidebar-nav-item @(ViewBag.Sort == "mostviews" ? "active" : "")">
                            <a href="@Url.Action("Index", "Forum", new { courseId = topic?.Forum?.CourseId, sort = "mostviews" })" class="nav-link-item">
                                <i class="bi bi-lightbulb"></i>
                                <span data-i18n-vi="Phổ biến hôm nay" data-i18n-en="Popular of the day">Phổ biến hôm nay</span>
                            </a>
                        </div>
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="sidebar-section mb-4">
                        <label class="sidebar-title mb-2">
                            <i class="bi bi-sort-down"></i>
                            <span data-i18n-vi="Sắp xếp theo" data-i18n-en="Sort by">Sắp xếp theo</span>
                        </label>
                        <form method="get" action="@Url.Action("Index", "Forum")" class="sort-form">
                            <input type="hidden" name="courseId" value="@topic?.Forum?.CourseId" />
                            <select name="sort" class="form-select sidebar-sort-select" onchange="this.form.submit()">
                                <option value="newest" selected="@(ViewBag.Sort == "newest" || ViewBag.Sort == null)">🕐 Mới nhất</option>
                                <option value="mostreplies" selected="@(ViewBag.Sort == "mostreplies")">💬 Nhiều phản hồi nhất</option>
                                <option value="mostviews" selected="@(ViewBag.Sort == "mostviews")">👁️ Nhiều lượt xem nhất</option>
                                <option value="oldest" selected="@(ViewBag.Sort == "oldest")">📅 Cũ nhất</option>
                            </select>
                        </form>
                    </div>

                    <!-- Popular Tags -->
                    <div class="sidebar-section">
                        <h6 class="sidebar-title">
                            <i class="bi bi-tags"></i>
                            <span data-i18n-vi="Tags phổ biến" data-i18n-en="Popular Tags">Tags phổ biến</span>
                        </h6>
                        <div class="popular-tags-list">
                            @if (ViewBag.PopularTags != null)
                            {
                                var tags = ViewBag.PopularTags as dynamic;
                                @foreach (var tag in tags)
                                {
                                    <a href="@Url.Action("Index", "Forum", new { courseId = topic?.Forum?.CourseId, tag = tag.TagName })" class="tag-item">
                                        <i class="bi bi-hash"></i>
                                        <span>@tag.TagName</span>
                                        <span class="tag-count">@tag.Count</span>
                                    </a>
                                }
                            }
                            else
                            {
                                <p class="text-muted small" data-i18n-vi="Chưa có tag nào" data-i18n-en="No tags yet">Chưa có tag nào</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 col-md-8">
                <div class="mb-3">
                    <a href="@Url.Action("Index", "Forum", new { courseId = topic?.Forum?.CourseId })" class="btn-back-forum">
                        <i class="bi bi-arrow-left me-1"></i>
                        <span data-i18n-vi="Quay lại diễn đàn" data-i18n-en="Back to forum">Quay lại diễn đàn</span>
                    </a>
                </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (topic != null)
            {
                <!-- Topic Header -->
                <div class="topic-card mb-4">
                    <div class="topic-header">
                        <div class="topic-header-main">
                            <div class="topic-title-wrapper">
                                <h1 class="topic-title">@topic.Title</h1>
                                <div class="topic-badges">
                                    @if (topic.Status == "Pinned")
                                    {
                                        <span class="status-badge pinned">
                                            <i class="bi bi-pin-fill"></i>
                                            <span data-i18n-vi="Đã ghim" data-i18n-en="Pinned">Đã ghim</span>
                                        </span>
                                    }
                                    @if (topic.Status == "Solved")
                                    {
                                        <span class="status-badge solved">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span data-i18n-vi="Đã giải quyết" data-i18n-en="Solved">Đã giải quyết</span>
                                        </span>
                                    }
                                    @if (topic.Status == "Hot")
                                    {
                                        <span class="status-badge hot">
                                            <i class="bi bi-fire"></i>
                                            <span data-i18n-vi="Chủ đề nổi bật" data-i18n-en="Hot topic">Chủ đề nổi bật</span>
                                        </span>
                                    }
                                    @if (topic.Status == "Locked")
                                    {
                                        <span class="status-badge locked">
                                            <i class="bi bi-lock-fill"></i>
                                            <span data-i18n-vi="Đã khóa" data-i18n-en="Locked">Đã khóa</span>
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="topic-actions">
                                @if ((isInstructor || isTopicOwner) && topic.Status != "Locked")
                                {
                                    <button type="button" class="action-btn solved-btn" onclick="markAsSolved('@topic.TopicId')" title="@(topic.Status == "Solved" ? "Bỏ đánh dấu" : "Đánh dấu đã giải quyết")">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                }
                                @if (isInstructor || isTopicOwner)
                                {
                                    <button type="button" class="action-btn delete-btn" onclick="deleteTopic('@topic.TopicId')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                <button type="button" class="action-btn report-btn" onclick="showReportModal('topic', '@topic.TopicId')" title="Báo cáo">
                                    <i class="bi bi-flag"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="topic-body">
                        <div class="topic-meta-info">
                            <div class="user-info-card">
                                <img src="@(topic.User?.Avatar ?? "/images/default-avatar.jpg")" 
                                     alt="@(topic.User?.FullName ?? topic.UserName)" 
                                     class="user-avatar">
                                <div class="user-details">
                                    <div class="user-name">@(topic.User?.FullName ?? topic.UserName)</div>
                                    <div class="user-meta">
                                        <span><i class="bi bi-clock"></i> @topic.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="topic-stats">
                                <div class="stat-item">
                                    <i class="bi bi-eye"></i>
                                    <span>@topic.ViewCount</span>
                                </div>
                                <div class="stat-item">
                                    <i class="bi bi-chat-dots"></i>
                                    <span>@topic.ReplyCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="topic-content">
                            @Html.Raw(topic.Content)
                        </div>
                        @if (topic.TopicTags != null && topic.TopicTags.Any())
                        {
                            <div class="topic-tags">
                                @foreach (var tag in topic.TopicTags)
                                {
                                    <a href="@Url.Action("Index", "Forum", new { courseId = topic.Forum?.CourseId, tag = tag.TagName })" class="tag-badge">
                                        <i class="bi bi-hash"></i>
                                        <span>@tag.TagName</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Posts Section -->
                <div class="posts-section">
                    <h3 class="section-title">
                        <i class="bi bi-chat-dots"></i>
                        <span data-i18n-vi="Phản hồi" data-i18n-en="Replies">Phản hồi</span>
                        <span class="reply-count">@posts.Count</span>
                    </h3>

                    @if (posts != null && posts.Any())
                    {
                        <div class="posts-list">
                            @foreach (var post in posts)
                            {
                                var replyViewData = new ViewDataDictionary(ViewData)
                                {
                                    ["ReplyTopicId"] = topic?.TopicId,
                                    ["ReplyCurrentUser"] = userName,
                                    ["ReplyIsInstructor"] = isInstructor,
                                    ["ReplyLevel"] = 1
                                };
                                @await Html.PartialAsync("_ReplyItem", post, replyViewData)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="no-replies">
                            <i class="bi bi-chat-dots"></i>
                            <p data-i18n-vi="Chưa có phản hồi nào" data-i18n-en="No replies yet">Chưa có phản hồi nào</p>
                        </div>
                    }

                    @if (topic.Status != "Locked")
                    {
                        <!-- Add Reply Form -->
                        <div class="add-reply-section">
                            <h4 class="reply-form-title">
                                <i class="bi bi-reply"></i>
                                <span data-i18n-vi="Thêm phản hồi" data-i18n-en="Add Reply">Thêm phản hồi</span>
                            </h4>
                            <form id="addReplyForm" class="reply-form">
                                <div class="reply-editor-wrapper">
                                    <div id="replyEditor" class="reply-quill-editor"></div>
                                    <input type="hidden" id="replyContent" name="content" />
                                </div>
                                <div class="reply-form-footer">
                                    <div class="reply-form-actions">
                                        <button type="button" class="btn-cancel" onclick="clearReplyForm()">
                                            <i class="bi bi-x"></i>
                                            <span data-i18n-vi="Hủy" data-i18n-en="Cancel">Hủy</span>
                                        </button>
                                        <button type="submit" class="btn-submit-primary">
                                            <i class="bi bi-send"></i>
                                            <span data-i18n-vi="Gửi phản hồi" data-i18n-en="Send Reply">Gửi phản hồi</span>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="locked-message">
                            <i class="bi bi-lock-fill"></i>
                            <span data-i18n-vi="Chủ đề này đã bị khóa" data-i18n-en="This topic is locked">Chủ đề này đã bị khóa</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span data-i18n-vi="Không tìm thấy chủ đề" data-i18n-en="Topic not found">Không tìm thấy chủ đề</span>
                </div>
            }
            </div>
        </div>
    </div>
</div>

<!-- Image Modal -->
<div id="imageModal" class="image-modal">
    <span class="image-modal-close" onclick="closeImageModal()">&times;</span>
    <img id="imageModalImg" class="image-modal-content" />
</div>

<!-- Report Modal -->
<div id="reportModal" class="custom-modal">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <h3 class="custom-modal-title">Báo cáo</h3>
            <button type="button" class="custom-modal-close" onclick="closeReportModal()">&times;</button>
        </div>
        <div class="custom-modal-body">
            <form id="reportForm">
                <input type="hidden" id="reportType" name="type" />
                <input type="hidden" id="reportId" name="id" />
                <div class="report-reason-section">
                    <label class="report-label">Lý do báo cáo:</label>
                    <div class="report-reasons">
                        <label class="report-reason-item">
                            <input type="radio" name="reportReason" value="1" />
                            <span>1. Spam</span>
                        </label>
                        <label class="report-reason-item">
                            <input type="radio" name="reportReason" value="2" />
                            <span>2. Inappropriate</span>
                        </label>
                        <label class="report-reason-item">
                            <input type="radio" name="reportReason" value="3" />
                            <span>3. Harassment</span>
                        </label>
                        <label class="report-reason-item">
                            <input type="radio" name="reportReason" value="4" />
                            <span>4. Copyright</span>
                        </label>
                        <label class="report-reason-item">
                            <input type="radio" name="reportReason" value="5" />
                            <span>5. Other</span>
                        </label>
                    </div>
                </div>
                <div class="report-description-section">
                    <label class="report-label">Mô tả chi tiết (tùy chọn):</label>
                    <textarea id="reportDescription" class="report-description-input" rows="4" placeholder="Nhập mô tả chi tiết về lý do báo cáo..."></textarea>
                </div>
            </form>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="custom-modal-btn custom-modal-btn-cancel" onclick="closeReportModal()">Hủy</button>
            <button type="button" id="reportModalSubmit" class="custom-modal-btn custom-modal-btn-ok">Gửi báo cáo</button>
        </div>
    </div>
</div>

<!-- Confirm Modal -->
<div id="confirmModal" class="custom-modal">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <h3 class="custom-modal-title">Xác nhận</h3>
            <button type="button" class="custom-modal-close" onclick="closeConfirmModal()">&times;</button>
        </div>
        <div class="custom-modal-body">
            <p id="confirmMessage"></p>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="custom-modal-btn custom-modal-btn-cancel" onclick="closeConfirmModal()">Hủy</button>
            <button type="button" id="confirmModalOk" class="custom-modal-btn custom-modal-btn-ok">OK</button>
        </div>
    </div>
</div>

<!-- Quill.js CSS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<!-- Quill.js JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>
    // Initialize Quill Editor for Reply
    let replyQuill;
    document.addEventListener('DOMContentLoaded', function() {
        replyQuill = new Quill('#replyEditor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    [{ 'size': ['small', false, 'large', 'huge'] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['link', 'image'],
                    ['blockquote', 'code-block'],
                    ['clean']
                ]
            },
            placeholder: 'Viết phản hồi của bạn...'
        });

        // Update hidden input when content changes
        replyQuill.on('text-change', function() {
            const html = replyQuill.root.innerHTML;
            document.getElementById('replyContent').value = html;
        });

        // Handle image upload in editor
        const toolbar = replyQuill.getModule('toolbar');
        toolbar.addHandler('image', function() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();

            input.onchange = async function() {
                const file = input.files[0];
                if (file) {
                    // Show loading
                    const range = replyQuill.getSelection(true);
                    if (!range) {
                        replyQuill.setSelection(replyQuill.getLength());
                    }
                    const currentRange = replyQuill.getSelection(true);
                    replyQuill.insertText(currentRange.index, 'Đang tải hình ảnh...', 'user');
                    replyQuill.setSelection(currentRange.index + 20);

                    // Upload image
                    const formData = new FormData();
                    formData.append('image', file);
                    formData.append('__RequestVerificationToken', getRequestVerificationToken());

                    try {
                        const response = await fetch('@Url.Action("UploadImage", "Forum")', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();
                        if (data.success) {
                            replyQuill.deleteText(currentRange.index, 20);
                            replyQuill.insertEmbed(currentRange.index, 'image', data.url);
                            replyQuill.setSelection(currentRange.index + 1);
                            
                            // Add line break after image
                            replyQuill.insertText(currentRange.index + 1, '\n', 'user');
                        } else {
                            replyQuill.deleteText(currentRange.index, 20);
                            alert('Lỗi khi tải hình ảnh: ' + (data.message || 'Vui lòng thử lại'));
                        }
                    } catch (error) {
                        const currentPos = replyQuill.getSelection(true);
                        if (currentPos) {
                            replyQuill.deleteText(currentPos.index, 20);
                        }
                        alert('Lỗi khi tải hình ảnh: ' + error.message);
                    }
                }
            };
        });
    });

    function getRequestVerificationToken() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        return token ? token.value : '';
    }

    function showReportModal(type, id) {
        document.getElementById('reportType').value = type;
        document.getElementById('reportId').value = id;
        document.getElementById('reportModal').style.display = 'flex';
    }

    function closeReportModal() {
        document.getElementById('reportModal').style.display = 'none';
        document.getElementById('reportForm').reset();
    }

    function showConfirmModal(message, onConfirm) {
        document.getElementById('confirmMessage').textContent = message;
        document.getElementById('confirmModal').style.display = 'flex';
        const okBtn = document.getElementById('confirmModalOk');
        okBtn.onclick = function() {
            if (onConfirm) onConfirm();
            closeConfirmModal();
        };
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').style.display = 'none';
    }

    function openImageModal(imageSrc) {
        const modal = document.getElementById('imageModal');
        const modalImg = document.getElementById('imageModalImg');
        modal.style.display = 'flex';
        modalImg.src = imageSrc;
    }

    function closeImageModal() {
        document.getElementById('imageModal').style.display = 'none';
    }

    window.onclick = function(event) {
        const imageModal = document.getElementById('imageModal');
        const reportModal = document.getElementById('reportModal');
        const confirmModal = document.getElementById('confirmModal');
        
        if (event.target == imageModal) {
            closeImageModal();
        }
        if (event.target == reportModal) {
            closeReportModal();
        }
        if (event.target == confirmModal) {
            closeConfirmModal();
        }
    }

    document.getElementById('reportModalSubmit')?.addEventListener('click', function() {
        const type = document.getElementById('reportType').value;
        const id = document.getElementById('reportId').value;
        const reason = document.querySelector('input[name="reportReason"]:checked')?.value;
        const description = document.getElementById('reportDescription').value;

        if (!reason) {
            alert('Vui lòng chọn lý do báo cáo');
            return;
        }

        const reasonMap = {
            '1': 'Spam',
            '2': 'Inappropriate',
            '3': 'Harassment',
            '4': 'Copyright',
            '5': 'Other'
        };

        const params = new URLSearchParams();
        params.append('type', type);
        params.append('id', id);
        params.append('reason', reasonMap[reason]);
        if (description) {
            params.append('description', description);
        }
        params.append('__RequestVerificationToken', getRequestVerificationToken());

        fetch('@Url.Action("Report", "Forum")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getRequestVerificationToken()
            },
            body: params.toString()
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Báo cáo đã được gửi thành công');
                closeReportModal();
            } else {
                alert(data.message || 'Có lỗi xảy ra');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi gửi báo cáo');
        });
    });

    // Like Post
    function likePost(postId) {
        fetch('@Url.Action("LikePost", "Forum")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getRequestVerificationToken()
            },
            body: new URLSearchParams({
                postId: postId,
                __RequestVerificationToken: getRequestVerificationToken()
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const likeBtn = document.querySelector(`[data-post-id="${postId}"].like-btn-stackoverflow`);
                const likeCount = likeBtn?.querySelector('.like-count');
                if (likeBtn && likeCount) {
                    likeCount.textContent = data.likeCount;
                    if (data.isLiked) {
                        likeBtn.classList.add('liked');
                    } else {
                        likeBtn.classList.remove('liked');
                    }
                }
            } else {
                alert(data.message || 'Có lỗi xảy ra');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi like bài viết');
        });
    }

    // Delete Post
    function deletePost(postId) {
        showConfirmModal('Bạn có chắc chắn muốn xóa phản hồi này?', function() {
            fetch('@Url.Action("DeletePost", "Forum")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getRequestVerificationToken()
                },
                body: new URLSearchParams({
                    postId: postId,
                    __RequestVerificationToken: getRequestVerificationToken()
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const postElement = document.getElementById(`post-${postId}`);
                    if (postElement) {
                        postElement.remove();
                        // Update reply count
                        const replyCount = document.querySelector('.reply-count');
                        if (replyCount) {
                            const currentCount = parseInt(replyCount.textContent) || 0;
                            replyCount.textContent = Math.max(0, currentCount - 1);
                        }
                    }
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa phản hồi');
            });
        });
    }

    // Store Quill instances for reply forms
    const replyQuills = {};

    // Show Reply Form
    function showReplyForm(postId) {
        const formContainer = document.getElementById(`reply-form-${postId}`);
        if (formContainer) {
            const isVisible = formContainer.style.display !== 'none';
            formContainer.style.display = isVisible ? 'none' : 'block';
            
            // Initialize Quill editor if not already initialized
            if (!isVisible && !replyQuills[postId]) {
                const editorId = `reply-editor-${postId}`;
                const editorElement = document.getElementById(editorId);
                if (editorElement && typeof Quill !== 'undefined') {
                    replyQuills[postId] = new Quill(`#${editorId}`, {
                        theme: 'snow',
                        modules: {
                            toolbar: [
                                [{ 'header': [1, 2, 3, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'color': [] }, { 'background': [] }],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                ['link', 'image'],
                                ['blockquote', 'code-block'],
                                ['clean']
                            ]
                        },
                        placeholder: 'Viết phản hồi của bạn...'
                    });

                    // Update hidden input when content changes
                    replyQuills[postId].on('text-change', function() {
                        const html = replyQuills[postId].root.innerHTML;
                        const hiddenInput = document.getElementById(`reply-content-${postId}`);
                        if (hiddenInput) {
                            hiddenInput.value = html;
                        }
                    });

                    // Handle image upload in editor
                    const toolbar = replyQuills[postId].getModule('toolbar');
                    toolbar.addHandler('image', function() {
                        const input = document.createElement('input');
                        input.setAttribute('type', 'file');
                        input.setAttribute('accept', 'image/*');
                        input.click();

                        input.onchange = async function() {
                            const file = input.files[0];
                            if (file) {
                                const range = replyQuills[postId].getSelection(true);
                                if (!range) {
                                    replyQuills[postId].setSelection(replyQuills[postId].getLength());
                                }
                                const currentRange = replyQuills[postId].getSelection(true);
                                replyQuills[postId].insertText(currentRange.index, 'Đang tải hình ảnh...', 'user');
                                replyQuills[postId].setSelection(currentRange.index + 20);

                                const formData = new FormData();
                                formData.append('image', file);
                                formData.append('__RequestVerificationToken', getRequestVerificationToken());

                                try {
                                    const response = await fetch('@Url.Action("UploadImage", "Forum")', {
                                        method: 'POST',
                                        body: formData
                                    });

                                    const data = await response.json();
                                    if (data.success) {
                                        replyQuills[postId].deleteText(currentRange.index, 20);
                                        replyQuills[postId].insertEmbed(currentRange.index, 'image', data.url);
                                        replyQuills[postId].setSelection(currentRange.index + 1);
                                        replyQuills[postId].insertText(currentRange.index + 1, '\n', 'user');
                                    } else {
                                        replyQuills[postId].deleteText(currentRange.index, 20);
                                        alert('Lỗi khi tải hình ảnh: ' + (data.message || 'Vui lòng thử lại'));
                                    }
                                } catch (error) {
                                    const currentPos = replyQuills[postId].getSelection(true);
                                    if (currentPos) {
                                        replyQuills[postId].deleteText(currentPos.index, 20);
                                    }
                                    alert('Lỗi khi tải hình ảnh: ' + error.message);
                                }
                            }
                        };
                    });
                }
            }
        }
    }

    // Hide Reply Form
    function hideReplyForm(postId) {
        const formContainer = document.getElementById(`reply-form-${postId}`);
        if (formContainer) {
            formContainer.style.display = 'none';
            // Clear Quill editor if exists
            if (replyQuills[postId]) {
                replyQuills[postId].setContents([]);
                replyQuills[postId].setText('');
            }
            const textarea = formContainer.querySelector('.reply-textarea');
            if (textarea) {
                textarea.value = '';
            }
            const hiddenInput = document.getElementById(`reply-content-${postId}`);
            if (hiddenInput) {
                hiddenInput.value = '';
            }
        }
    }

    // Submit Reply
    function submitReply(event, topicId, parentPostId) {
        event.preventDefault();
        const form = event.target;
        let content = '';
        
        // Get content from Quill editor or textarea
        const hiddenInput = form.querySelector('.reply-content-hidden');
        if (hiddenInput && hiddenInput.value) {
            content = hiddenInput.value.trim();
        } else if (replyQuills[parentPostId]) {
            content = replyQuills[parentPostId].root.innerHTML.trim();
        } else {
            const quillEditor = form.querySelector('.ql-editor');
            if (quillEditor) {
                content = quillEditor.innerHTML.trim();
            } else {
                const textarea = form.querySelector('.reply-textarea');
                if (textarea) {
                    content = textarea.value.trim();
                }
            }
        }

        // Check if content is empty
        const text = content.replace(/<[^>]*>/g, '').trim();
        if (!text || content === '<p><br></p>') {
            alert('Vui lòng nhập nội dung phản hồi');
            return;
        }

        const formData = new FormData();
        formData.append('topicId', topicId);
        formData.append('content', content);
        if (parentPostId) {
            formData.append('parentPostId', parentPostId);
        }
        formData.append('__RequestVerificationToken', getRequestVerificationToken());

        fetch('@Url.Action("CreatePost", "Forum")', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': getRequestVerificationToken()
            },
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Có lỗi xảy ra');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi gửi phản hồi');
        });
    }

    // Clear Reply Form
    function clearReplyForm() {
        if (replyQuill) {
            replyQuill.setContents([]);
            replyQuill.setText('');
        }
        const contentInput = document.getElementById('replyContent');
        
        if (contentInput) {
            contentInput.value = '';
        }
    }

    // Mark As Solved
    function markAsSolved(topicId) {
        fetch('@Url.Action("MarkAsSolved", "Forum")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getRequestVerificationToken()
            },
            body: new URLSearchParams({
                topicId: topicId,
                __RequestVerificationToken: getRequestVerificationToken()
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Có lỗi xảy ra');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi đánh dấu đã giải quyết');
        });
    }

    // Delete Topic
    function deleteTopic(topicId) {
        showConfirmModal('Bạn có chắc chắn muốn xóa chủ đề này?', function() {
            fetch('@Url.Action("DeleteTopic", "Forum")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getRequestVerificationToken()
                },
                body: new URLSearchParams({
                    topicId: topicId,
                    __RequestVerificationToken: getRequestVerificationToken()
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '@Url.Action("Index", "Forum", new { courseId = topic?.Forum?.CourseId })';
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa chủ đề');
            });
        });
    }

    // Handle Add Reply Form Submit
    document.getElementById('addReplyForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Get content from Quill editor
        let content = '';
        if (replyQuill) {
            content = replyQuill.root.innerHTML.trim();
            // Check if content is empty (only contains <p><br></p>)
            const text = replyQuill.getText().trim();
            if (!text) {
                alert('Vui lòng nhập nội dung phản hồi');
                return;
            }
        } else {
            const contentInput = document.getElementById('replyContent');
            content = contentInput?.value.trim() || '';
        }

        if (!content || content === '<p><br></p>') {
            alert('Vui lòng nhập nội dung phản hồi');
            return;
        }
        
        const imagesInput = document.getElementById('replyImages');

        const formData = new FormData();
        formData.append('topicId', '@topic?.TopicId');
        formData.append('content', content);
        formData.append('__RequestVerificationToken', getRequestVerificationToken());

        fetch('@Url.Action("CreatePost", "Forum")', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': getRequestVerificationToken()
            },
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Có lỗi xảy ra');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi gửi phản hồi');
        });
    });
</script>

