@model IEnumerable<LearningManagementSystem.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "_AdminLayout";
}

<!-- Thông báo -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Nút thêm người dùng -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Quản lý người dùng</h2>
    <a asp-action="CreateUser" asp-controller="Admin" asp-area="" class="btn btn-purple">
        <i class="bi bi-plus-circle me-2"></i> Thêm người dùng mới
    </a>
</div>

<!-- Bảng người dùng -->
@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Không có người dùng nào trong hệ thống.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@(user.Role != null ? user.Role.RoleName : "Không xác định")</td>
                    <td>
                        <a asp-action="EditUser" asp-controller="Admin" asp-area="" asp-route-userName="@user.UserName" class="btn btn-warning btn-sm me-1" data-bs-toggle="tooltip" title="Chỉnh sửa người dùng">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteUser" asp-controller="Admin" asp-area="" asp-route-userName="@user.UserName" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này không?');">
                            <button type="submit" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Xóa người dùng">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        // Kích hoạt tooltip Bootstrap
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}