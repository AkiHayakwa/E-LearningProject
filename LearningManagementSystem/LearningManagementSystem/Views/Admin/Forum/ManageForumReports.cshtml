@model List<LearningManagementSystem.Models.Report>
@{
    ViewData["Title"] = "Quản lý báo cáo diễn đàn";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-flag-fill me-2"></i>Quản lý báo cáo diễn đàn</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("ManageForumReports", "Admin")" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Lọc theo trạng thái:</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        @if (ViewBag.Status == "All")
                        {
                            <option value="All" selected>Tất cả</option>
                        }
                        else
                        {
                            <option value="All">Tất cả</option>
                        }
                        @if (ViewBag.Status == "Pending")
                        {
                            <option value="Pending" selected>Chờ xử lý</option>
                        }
                        else
                        {
                            <option value="Pending">Chờ xử lý</option>
                        }
                        @if (ViewBag.Status == "Resolved")
                        {
                            <option value="Resolved" selected>Đã xử lý</option>
                        }
                        else
                        {
                            <option value="Resolved">Đã xử lý</option>
                        }
                        @if (ViewBag.Status == "Rejected")
                        {
                            <option value="Rejected" selected>Đã từ chối</option>
                        }
                        else
                        {
                            <option value="Rejected">Đã từ chối</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách Reports -->
    @if (Model != null && Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Loại</th>
                                <th>Nội dung</th>
                                <th>Người báo cáo</th>
                                <th>Lý do</th>
                                <th>Mô tả</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td>
                                        @if (report.PostId != null)
                                        {
                                            <span class="badge bg-info">Post</span>
                                        }
                                        else if (report.TopicId != null)
                                        {
                                            <span class="badge bg-primary">Topic</span>
                                        }
                                    </td>
                                    <td>
                                        @if (report.PostId != null)
                                        {
                                            <a href="@Url.Action("TopicDetail", "Forum", new { id = report.Post?.TopicId })" target="_blank">
                                                Xem post
                                            </a>
                                        }
                                        else if (report.TopicId != null)
                                        {
                                            <a href="@Url.Action("TopicDetail", "Forum", new { id = report.TopicId })" target="_blank">
                                                Xem topic
                                            </a>
                                        }
                                    </td>
                                    <td>@(report.ReportedByUser?.FullName ?? report.ReportedBy)</td>
                                    <td>
                                        <span class="badge bg-warning">@report.Reason</span>
                                    </td>
                                    <td>
                                        <small>@(report.Description?.Length > 50 ? report.Description.Substring(0, 50) + "..." : report.Description)</small>
                                    </td>
                                    <td>
                                        @if (report.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">Chờ xử lý</span>
                                        }
                                        else if (report.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">Đã xử lý</span>
                                        }
                                        else if (report.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Đã từ chối</span>
                                        }
                                    </td>
                                    <td>@report.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (report.Status == "Pending")
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <a href="@Url.Action("ForumReportDetail", "Admin", new { id = report.ReportId })" 
                                                   class="btn btn-outline-primary" title="Xem chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button type="button" 
                                                        class="btn btn-outline-success" 
                                                        onclick="resolveReport('@report.ReportId', 'Resolve')"
                                                        title="Xử lý">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-outline-danger" 
                                                        onclick="resolveReport('@report.ReportId', 'Reject')"
                                                        title="Từ chối">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">
                                                @if (report.ResolvedByUser != null)
                                                {
                                                    <div>Bởi: @report.ResolvedByUser.FullName</div>
                                                }
                                                @if (report.ResolvedDate.HasValue)
                                                {
                                                    <div>@report.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                                }
                                            </small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("ManageForumReports", "Admin", new { status = ViewBag.Status, page = ViewBag.CurrentPage - 1 })">Trước</a>
                                </li>
                            }
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ManageForumReports", "Admin", new { status = ViewBag.Status, page = i })">@i</a>
                                </li>
                            }
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("ManageForumReports", "Admin", new { status = ViewBag.Status, page = ViewBag.CurrentPage + 1 })">Sau</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>Không có báo cáo nào.
        </div>
    }
</div>

<script>
    function resolveReport(reportId, action) {
        const actionText = action === 'Resolve' ? 'xử lý' : 'từ chối';
        if (!confirm(`Bạn có chắc chắn muốn ${actionText} báo cáo này?`)) {
            return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("ResolveReport", "Admin")';
        
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '__RequestVerificationToken';
        tokenInput.value = token;
        form.appendChild(tokenInput);

        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'id';
        idInput.value = reportId;
        form.appendChild(idInput);

        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = action;
        form.appendChild(actionInput);

        document.body.appendChild(form);
        form.submit();
    }
</script>

