@model LearningManagementSystem.Models.Comment

@{
    ViewData["Title"] = "Sửa bình luận";
    Layout = "_Layout";
}

<h1>Sửa bình luận</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="EditComment" method="post">
    <input type="hidden" asp-for="CommentId" />
    <input type="hidden" asp-for="CourseId" />
    <input type="hidden" asp-for="UserName" />
    <div class="form-group">
        <label class="control-label">Người dùng</label>
        <input class="form-control" value="@ViewBag.UserFullName" readonly />
    </div>
    <div class="form-group">
        <label class="control-label">Khóa học</label>
        <input class="form-control" value="@ViewBag.CourseName" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Content" class="control-label">Nội dung</label>
        <textarea asp-for="Content" class="form-control" rows="3" required maxlength="1000" placeholder="Nhập nội dung bình luận..."></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="ManageComments" class="btn btn-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}