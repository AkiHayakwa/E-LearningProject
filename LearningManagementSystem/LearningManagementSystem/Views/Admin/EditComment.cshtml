@model LearningManagementSystem.Models.Comment

@{
    ViewData["Title"] = "Sửa bình luận";
}

<h2>Sửa bình luận</h2>

<form asp-action="EditComment" method="post">
    <input type="hidden" asp-for="CommentId" />
    <div class="form-group">
        <label asp-for="UserId" class="control-label">Người dùng</label>
        <select asp-for="UserId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "UserId", "FullName"))">
            <option value="">Chọn người dùng</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LessonId" class="control-label">Bài học</label>
        <select asp-for="LessonId" class="form-control" asp-items="@(new SelectList(ViewBag.Lessons, "LessonId", "LessonTitle"))">
            <option value="">Chọn bài học</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Content" class="control-label"></label>
        <textarea asp-for="Content" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="ManageComments" class="btn btn-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}