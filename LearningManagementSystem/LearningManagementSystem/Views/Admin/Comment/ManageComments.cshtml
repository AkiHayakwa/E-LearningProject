@model IEnumerable<LearningManagementSystem.Models.Comment>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý bình luận - E-Learning System (Admin)";
}

<div class="d-flex">
    <!-- Sidebar -->
    <div id="sidebar" class="p-3" style="background: linear-gradient(180deg, #f7e1a1, #f5d78e); min-height: 100vh; width: 200px; position: fixed; transition: transform 0.3s ease;">
        <div class="mb-4">
            <h4 class="text-dark">E-Learning System</h4>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-blue" asp-action="Index" asp-controller="Home">
                    <i class="bi bi-house-door me-2"></i> Home
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-blue" asp-action="Dashboard" asp-controller="Admin">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-green" asp-action="ManageCourses" asp-controller="Admin">
                    <i class="bi bi-book me-2"></i> Course Management
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-yellow active" asp-action="ManageComments" asp-controller="Admin">
                    <i class="bi bi-chat-dots me-2"></i> Comment Management
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-cyan" asp-action="ManageUsers" asp-controller="Admin">
                    <i class="bi bi-people me-2"></i> User Management
                </a>
            </li>
            <li class="nav-item mt-5">
                <a class="nav-link admin-btn admin-btn-blue" asp-action="Logout" asp-controller="Account">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div id="main-content" class="flex-grow-1 p-4" style="margin-left: 200px; background: #f8f9fa; min-height: 100vh; transition: margin-left 0.3s ease;">
        <div class="container">
            <!-- Nút ẩn/hiện sidebar -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-dark" style="background: #f5d78e; padding: 10px 20px; border-radius: 5px;">
                    Quản lý bình luận - E-Learning System (Admin)
                </h1>
                <button id="toggle-sidebar" class="admin-btn admin-btn-blue">
                    <i id="toggle-icon" class="bi bi-chevron-left"></i>
                </button>
            </div>

            <!-- Thông báo -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" style="border-radius: 5px;">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" style="border-radius: 5px;">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Bảng danh sách bình luận -->
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title">Danh sách bình luận</h5>
                    @if (Model != null && Model.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Người dùng</th>
                                    <th>Khóa học</th>
                                    <th>Nội dung</th>
                                    <th>Ngày tạo</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comment in Model)
                                {
                                    <tr>
                                        <td>@comment.UserName</td>
                                        <td>@(comment.Course?.CourseName ?? "Không có khóa học")</td>
                                        <td>@comment.Content</td>
                                        <td>@comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <form asp-action="DeleteComment" asp-controller="Admin" asp-route-id="@comment.CommentId" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bình luận này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="admin-btn admin-btn-red btn-sm">
                                                    <i class="bi bi-trash me-1"></i> Xóa
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có bình luận nào.</p>
                    }

                    <!-- Nút quay lại -->
                    <div class="mt-4">
                        <a asp-action="Dashboard" asp-controller="Admin" class="admin-btn admin-btn-blue">
                            <i class="bi bi-arrow-left me-2"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Sidebar */
        #sidebar {
            background: linear-gradient(180deg, #f7e1a1, #f5d78e);
            width: 200px;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

            #sidebar.hidden {
                transform: translateX(-200px);
            }

        /* Main Content */
        #main-content {
            margin-left: 200px;
            transition: margin-left 0.3s ease;
        }

            #main-content.expanded {
                margin-left: 0;
            }

        /* Admin Button */
        .admin-btn {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            border-radius: 8px;
            color: #fff !important;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            border: none;
            font-weight: 500;
            text-decoration: none;
        }

        .admin-btn-blue {
            background: linear-gradient(135deg, #007bff, #0056b3);
        }

        .admin-btn-green {
            background: linear-gradient(135deg, #2ecc71, #27ae60);
        }

        .admin-btn-yellow {
            background: linear-gradient(135deg, #f1c40f, #d4ac0d);
        }

        .admin-btn-cyan {
            background: linear-gradient(135deg, #17a2b8, #117a8b);
        }

        .admin-btn-red {
            background: linear-gradient(135deg, #dc3545, #b02a37);
        }

        .admin-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .admin-btn:active {
            transform: translateY(1px);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .admin-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: 0.5s;
        }

        .admin-btn:hover::before {
            left: 100%;
        }

        .admin-btn.active {
            background: linear-gradient(135deg, #0056b3, #003d82);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .admin-btn-yellow.active {
            background: linear-gradient(135deg, #d4ac0d, #b7950b);
        }

        .admin-btn i {
            font-size: 1.2rem;
        }

        /* Table */
        .table {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            border-collapse: separate;
            border-spacing: 0;
        }

            .table th, .table td {
                vertical-align: middle;
                padding: 12px 15px;
            }

            .table th {
                background: #f5d78e;
                color: #333;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.9rem;
                letter-spacing: 0.5px;
            }

            .table tbody tr {
                transition: background 0.3s ease;
            }

        .table-hover tbody tr:hover {
            background: #f1f1f1;
            transform: scale(1.01);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .table td {
            border-bottom: 1px solid #e9ecef;
        }

        /* Card */
        .card {
            border: none;
            border-radius: 10px;
        }

        .card-body {
            padding: 20px;
        }

        /* Text muted */
        .text-muted {
            font-style: italic;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('main-content');
            const toggleButton = document.getElementById('toggle-sidebar');
            const toggleIcon = document.getElementById('toggle-icon');

            // Kiểm tra trạng thái sidebar từ localStorage
            const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true';
            if (isSidebarHidden) {
                sidebar.classList.add('hidden');
                mainContent.classList.add('expanded');
                toggleIcon.classList.remove('bi-chevron-left');
                toggleIcon.classList.add('bi-chevron-right');
            }

            // Xử lý sự kiện bấm nút toggle
            toggleButton.addEventListener('click', function () {
                sidebar.classList.toggle('hidden');
                mainContent.classList.toggle('expanded');

                // Cập nhật icon
                if (sidebar.classList.contains('hidden')) {
                    toggleIcon.classList.remove('bi-chevron-left');
                    toggleIcon.classList.add('bi-chevron-right');
                    localStorage.setItem('sidebarHidden', 'true');
                } else {
                    toggleIcon.classList.remove('bi-chevron-right');
                    toggleIcon.classList.add('bi-chevron-left');
                    localStorage.setItem('sidebarHidden', 'false');
                }
            });
        });
    </script>
}