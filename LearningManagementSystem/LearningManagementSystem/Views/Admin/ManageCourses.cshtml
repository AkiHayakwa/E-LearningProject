@model IEnumerable<LearningManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Quản lý khóa học";
    Layout = "_Layout";
}

<h1>Quản lý khóa học</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="AddCourse" class="btn btn-primary">Thêm khóa học</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Tên khóa học</th>
            <th>Mô tả</th>
            <th>Ngày tạo</th>
            <th>Giảng viên</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseName</td>
                <td>@course.Description</td>
                <td>@course.CreatedDate.ToString("dd/MM/yyyy")</td>
                <td>@(course.Instructor?.FullName ?? "Không có giảng viên")</td>
                <td>
                    <a asp-action="EditCourse" asp-route-id="@course.CourseId" class="btn btn-warning">Sửa</a>
                    <form asp-action="DeleteCourse" asp-route-id="@course.CourseId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa học này?');">
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>