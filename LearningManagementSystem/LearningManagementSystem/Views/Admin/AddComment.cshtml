@model LearningManagementSystem.Models.Comment

@{
    ViewData["Title"] = "Thêm bình luận";
    Layout = "_Layout";
}

<h1>Thêm bình luận</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="AddComment" method="post">
    <div class="form-group">
        <label asp-for="UserId">Người dùng</label>
        <select asp-for="UserId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "UserId", "FullName"))"></select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LessonId">Bài học</label>
        <select asp-for="LessonId" class="form-control" asp-items="@(new SelectList(ViewBag.Lessons, "LessonId", "LessonTitle"))"></select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Content">Nội dung</label>
        <textarea asp-for="Content" class="form-control"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Thêm</button>
    <a asp-action="ManageComments" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}