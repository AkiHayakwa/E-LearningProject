@model LearningManagementSystem.Models.Lesson

@{
    ViewData["Title"] = "Sửa bài học";
    Layout = "_Layout";
}

<h1>Sửa bài học</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="EditLesson" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="LessonId" />
    <div class="form-group">
        <label asp-for="LessonTitle">Tiêu đề bài học</label>
        <input asp-for="LessonTitle" class="form-control" required />
        <span asp-validation-for="LessonTitle" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Content">Nội dung</label>
        <textarea asp-for="Content" class="form-control"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OrderNumber">Số thứ tự</label>
        <input asp-for="OrderNumber" class="form-control" type="number" />
        <span asp-validation-for="OrderNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CourseId">Khóa học</label>
        <select asp-for="CourseId" class="form-control" asp-items="@(new SelectList(ViewBag.Courses, "CourseId", "CourseName"))" required>
            <option value="">Chọn khóa học</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="ManageLessons" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}