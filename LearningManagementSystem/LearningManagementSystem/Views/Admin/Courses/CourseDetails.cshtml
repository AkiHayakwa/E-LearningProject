@model LearningManagementSystem.Models.ViewModels.CourseDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết khóa học";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-8">
            <h1>@Model.Course.CourseName</h1>
            <p class="text-muted">Ngày tạo: @Model.Course.CreatedDate.ToString("dd/MM/yyyy")</p>
            @if (!string.IsNullOrEmpty(Model.Course.ImageUrl))
            {
                <img src="@Model.Course.ImageUrl" alt="@Model.Course.CourseName" class="img-fluid mb-4" style="max-height: 400px; object-fit: cover;" />
            }
            <p>@Model.Course.Description</p>

            @if (Model.IsEnrolled)
            {
                <p class="text-success">Bạn đã ghi danh vào khóa học này.</p>
            }
            else
            {
                <a href="#" class="btn btn-primary">Ghi danh ngay</a>
            }

            <h3 class="mt-5">Bình luận</h3>
            @if (Model.Comments.Any())
            {
                <ul class="list-group">
                    @foreach (var comment in Model.Comments)
                    {
                        <li class="list-group-item">
                            <strong>@comment.UserName</strong> - @comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            <p>@comment.Content</p>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">Chưa có bình luận nào.</p>
            }
        </div>
    </div>
</div>