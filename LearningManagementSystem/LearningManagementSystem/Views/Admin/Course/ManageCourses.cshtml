@model IEnumerable<LearningManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Quản lý khóa học";
    Layout = "_AdminLayout";
}

<!-- Thông báo -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Nút thêm khóa học -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Quản lý khóa học</h2>
    <a asp-action="CreateCourse" asp-controller="Admin" asp-area="" class="btn btn-purple">
        <i class="bi bi-plus-circle me-2"></i> Thêm khóa học mới
    </a>
</div>

<!-- Bảng khóa học -->
@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Không có khóa học nào trong hệ thống.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên khóa học</th>
                <th>Mô tả</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                        {
                            <img src="@course.ImageUrl" alt="@course.CourseName" />
                        }
                        else
                        {
                            <span class="text-muted">Không có hình ảnh</span>
                        }
                    </td>
                    <td>@course.CourseName</td>
                    <td class="text-truncate" style="max-width: 250px;" title="@course.Description">@course.Description</td>
                    <td>@course.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-action="EditCourse" asp-controller="Admin" asp-area="" asp-route-id="@course.CourseId" class="btn btn-warning btn-sm me-1" data-bs-toggle="tooltip" title="Chỉnh sửa khóa học">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteCourse" asp-controller="Admin" asp-area="" asp-route-id="@course.CourseId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa học này không?');">
                            <button type="submit" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Xóa khóa học">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        // Kích hoạt tooltip Bootstrap
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}