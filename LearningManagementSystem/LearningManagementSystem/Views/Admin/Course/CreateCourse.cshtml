@model LearningManagementSystem.Models.Course

@{
    Layout = "_Layout";
    ViewData["Title"] = "Thêm khóa học mới - E-Learning System (Admin)";
}

<div class="d-flex">
    <!-- Sidebar -->
    <div id="sidebar" class="p-3" style="background: linear-gradient(180deg, #f7e1a1, #f5d78e); min-height: 100vh; width: 200px; position: fixed; transition: transform 0.3s ease;">
        <div class="mb-4">
            <h4 class="text-dark">E-Learning System</h4>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-blue" asp-action="Index" asp-controller="Home">
                    <i class="bi bi-house-door me-2"></i> Home
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-blue" asp-action="Dashboard" asp-controller="Admin">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-green active" asp-action="ManageCourses" asp-controller="Admin">
                    <i class="bi bi-book me-2"></i> Course Management
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-yellow" asp-action="ManageComments" asp-controller="Admin">
                    <i class="bi bi-chat-dots me-2"></i> Comment Management
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link admin-btn admin-btn-cyan" asp-action="ManageUsers" asp-controller="Admin">
                    <i class="bi bi-people me-2"></i> User Management
                </a>
            </li>
            <li class="nav-item mt-5">
                <a class="nav-link admin-btn admin-btn-blue" asp-action="Logout" asp-controller="Account">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div id="main-content" class="flex-grow-1 p-4" style="margin-left: 200px; background: #f8f9fa; min-height: 100vh; transition: margin-left 0.3s ease;">
        <div class="container">
            <!-- Nút ẩn/hiện sidebar -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-dark" style="background: #f5d78e; padding: 10px 20px; border-radius: 5px;">
                    Thêm khóa học mới - E-Learning System (Admin)
                </h1>
                <button id="toggle-sidebar" class="admin-btn admin-btn-blue">
                    <i id="toggle-icon" class="bi bi-chevron-left"></i>
                </button>
            </div>

            <!-- Thông báo -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" style="border-radius: 5px;">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" style="border-radius: 5px;">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Form tạo khóa học -->
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title">Thêm khóa học mới</h5>
                    <form asp-action="CreateCourse" asp-controller="Admin" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="CourseName" class="form-label">Tên khóa học</label>
                            <input asp-for="CourseName" class="form-control" />
                            <span asp-validation-for="CourseName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="imageFile" class="form-label">Hình ảnh</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                            <span class="text-danger">@Html.ValidationMessage("imageFile")</span>
                        </div>

                        <button type="submit" class="admin-btn admin-btn-cyan">
                            <i class="bi bi-plus-circle me-2"></i> Thêm khóa học
                        </button>
                        <a asp-action="ManageCourses" asp-controller="Admin" class="admin-btn admin-btn-blue ms-2">
                            <i class="bi bi-arrow-left me-2"></i> Quay lại
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Sidebar */
        #sidebar {
            background: linear-gradient(180deg, #f7e1a1, #f5d78e);
            width: 200px;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

            #sidebar.hidden {
                transform: translateX(-200px);
            }

        /* Main Content */
        #main-content {
            margin-left: 200px;
            transition: margin-left 0.3s ease;
        }

            #main-content.expanded {
                margin-left: 0;
            }

        /* Admin Button */
        .admin-btn {
            display: inline-flex;
            align-items: center;
            padding: 10px 15px;
            border-radius: 8px;
            color: #fff !important;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            border: none;
            font-weight: 500;
            text-decoration: none;
        }

        .admin-btn-blue {
            background: linear-gradient(135deg, #007bff, #0056b3);
        }

        .admin-btn-green {
            background: linear-gradient(135deg, #2ecc71, #27ae60);
        }

        .admin-btn-yellow {
            background: linear-gradient(135deg, #f1c40f, #d4ac0d);
        }

        .admin-btn-cyan {
            background: linear-gradient(135deg, #17a2b8, #117a8b);
        }

        .admin-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .admin-btn:active {
            transform: translateY(1px);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .admin-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: 0.5s;
        }

        .admin-btn:hover::before {
            left: 100%;
        }

        .admin-btn.active {
            background: linear-gradient(135deg, #0056b3, #003d82);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .admin-btn-green.active {
            background: linear-gradient(135deg, #27ae60, #219653);
        }

        .admin-btn-cyan.active {
            background: linear-gradient(135deg, #117a8b, #0d6776);
        }

        .admin-btn i {
            font-size: 1.2rem;
        }

        /* Card */
        .card {
            border: none;
            border-radius: 10px;
        }

        .card-body {
            padding: 20px;
        }

        /* Form */
        .form-control, .form-control-file {
            border-radius: 5px;
        }

        .form-label {
            font-weight: 500;
        }

        textarea.form-control {
            resize: vertical;
        }
    </style>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('main-content');
            const toggleButton = document.getElementById('toggle-sidebar');
            const toggleIcon = document.getElementById('toggle-icon');

            // Kiểm tra trạng thái sidebar từ localStorage
            const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true';
            if (isSidebarHidden) {
                sidebar.classList.add('hidden');
                mainContent.classList.add('expanded');
                toggleIcon.classList.remove('bi-chevron-left');
                toggleIcon.classList.add('bi-chevron-right');
            }

            // Xử lý sự kiện bấm nút toggle
            toggleButton.addEventListener('click', function () {
                sidebar.classList.toggle('hidden');
                mainContent.classList.toggle('expanded');

                // Cập nhật icon
                if (sidebar.classList.contains('hidden')) {
                    toggleIcon.classList.remove('bi-chevron-left');
                    toggleIcon.classList.add('bi-chevron-right');
                    localStorage.setItem('sidebarHidden', 'true');
                } else {
                    toggleIcon.classList.remove('bi-chevron-right');
                    toggleIcon.classList.add('bi-chevron-left');
                    localStorage.setItem('sidebarHidden', 'false');
                }
            });
        });
    </script>
}